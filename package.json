{
  "name": "hu-shengwei-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/trim-dist.mjs && node scripts/subset-fonts.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:style": "node scripts/check-style.mjs",
    "check:audit": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "check:extlinks": "node scripts/check-extlinks.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:golden": "node scripts/content-golden.mjs",
    "fonts:budget": "node scripts/font-budget.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "^7.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.3",
    "@emnapi/runtime": "^1.11.3",
    "subset-font": "^2.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
