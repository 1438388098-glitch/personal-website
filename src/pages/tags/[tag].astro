---
import TagDetail from '../../templates/TagDetail.astro';
import { getPublishedPosts } from '../../lib/posts';
import { groupByTag } from '../../lib/tags';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  /* 已按发布时间降序，分桶保持原顺序，桶内天然就是新→旧，无需再排一次 */
  const byTag = groupByTag(await getPublishedPosts('zh'));
  /* 对方语言对应页存在性：en 标签页只覆盖有英文译文的标签 */
  const enPosts = await getCollection('postsEn');
  const enTagSet = new Set<string>(enPosts.flatMap((p) => p.data.tags));
  return [...byTag.entries()].map(([tag, posts]) => ({
    params: { tag },
    props: {
      tag,
      posts,
      lang: 'zh' as const,
      alternate: enTagSet.has(tag) ? `/en/tags/${tag}/` : null,
    },
  }));
}
---
<TagDetail {...Astro.props} />
