---
import PostDetail from '../../../templates/PostDetail.astro';
import { getPublishedPosts } from '../../../lib/posts';

/* en 博文详情：33 篇全量配对（check-i18n 门禁强制双向），中文原文永远存在，alternate 直连 */
export async function getStaticPaths() {
  const posts = await getPublishedPosts('en');
  return posts.map((p) => ({
    params: { slug: p.id },
    props: {
      post: p,
      lang: 'en' as const,
      alternate: `/blog/${p.id}/`,
    },
  }));
}
---
<PostDetail {...Astro.props} />
