---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublished } from '../lib/publish';
import { jsonForScript } from '../lib/search';

/* 正文压成纯文本：剥代码块、图片、链接语法与行内标记，限长避免索引虚胖 */
const toText = (md: string | undefined) =>
  (md ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]*)`/g, '$1')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^>\s?/gm, '')
    .replace(/[*_]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    /* snippet 只展示正负 200 字，4 千字外的正文命中价值极低：cap 控制内嵌索引体积 */
    .slice(0, 4000);

const docs = [
  ...(await getCollection('posts', isPublished)).map((p) => ({
    url: `/blog/${p.id}/`, title: p.data.title, description: p.data.description, tags: p.data.tags, text: toText(p.body), kind: '博客',
  })),
  ...(await getCollection('exam', (e) => !e.data.draft)).map((e) => ({
    url: `/exam/${e.id}/`, title: e.data.title, description: e.data.description, tags: [] as string[], text: toText(e.body), kind: '法考',
  })),
  ...(await getCollection('notes', (n) => !n.data.draft)).map((n) => ({
    url: `/notes/${n.id}/`, title: n.data.title, description: n.data.description, tags: [] as string[], text: toText(n.body), kind: '笔记',
  })),
  ...((await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)).map((p) => ({
    url: `/projects/${p.id}/`, title: p.data.title, description: p.data.summary, tags: [p.data.group], text: p.data.summary, kind: '项目',
  })),
  ...(await getCollection('toolbox')).map((t) => ({
    url: `/toolbox/#${t.id}`, title: t.data.name, description: t.data.description, tags: [t.data.category], text: t.data.description, kind: '工具',
  })),
];
---
<BaseLayout title="搜索" description="站内搜索：在已发布的博客、法考实录、研读笔记、项目案例与工具箱里找关键词。" noindex>
  <h1>搜索</h1>
  <p class="intro">{docs.length} 条内容，找关键词直达。</p>
  <noscript><p class="noscript">搜索需要启用 JavaScript；也可以改用无需脚本的<a href="/tags/">标签索引</a>。</p></noscript>
  <div class="searchbox">
    <input id="q" type="search" placeholder="试试：幻觉、错题、竞业限制…" autocomplete="off" aria-label="搜索关键词" />
    <p class="count" id="count" aria-live="polite"></p>
  </div>
  <ul id="results"></ul>
  <script type="application/json" id="search-data" set:html={jsonForScript(docs)} />
<script>
  import { escapeHtml, highlight, makeSnippet, scoreDoc } from '../lib/search';

  /* astro:page-load 首次加载与每次换页后都触发：与博客页 tabs 同理，顶层绑定会在返回本页后失灵 */
  document.addEventListener('astro:page-load', () => {
  const DATA: { url: string; title: string; description: string; tags: string[]; text: string; kind: string }[] = JSON.parse(
    document.getElementById('search-data')!.textContent!
  );
  const input = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('results')!;
  const count = document.getElementById('count')!;

  const run = () => {
    const raw = input.value.trim();
    list.innerHTML = '';
    if (!raw) { count.textContent = ''; return; }
    const terms = raw.split(/\s+/);
    const hits = DATA
      .map((d) => {
        const score = scoreDoc(d, terms);
        return score === null ? null : { ...d, score };
      })
      .filter((h): h is NonNullable<typeof h> => h !== null)
      .sort((a, b) => b.score - a.score)
      .slice(0, 20);

    count.textContent = hits.length
      ? `${hits.length} 条结果${hits.length >= 20 ? '（只显示前 20 条，换个更具体的词）' : ''}`
      : '没有匹配的内容，换个词试试。';

    list.innerHTML = hits.map((h) => {
      const snippet = makeSnippet(h.text, terms);
      return `<li><span class="kind">${escapeHtml(h.kind)}</span><a href="${h.url}">${escapeHtml(h.title)}</a><p class="snippet">${highlight(snippet, terms)}</p></li>`;
    }).join('');
  };

  let timer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(run, 150);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { clearTimeout(timer); run(); }
  });

  /* 页头迷你搜索框以 GET /search/?q= 提交：落地后带词出结果 */
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    input.value = initial;
    run();
  }
  });
</script>
<style>
  .intro { color: var(--text-muted); margin: 1.4rem 0 1.5rem; }
  .noscript { color: var(--text-muted); }
  .searchbox { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  /* 搜索框直角化：v3 描边语言，聚焦转强调蓝 */
  .searchbox input {
    flex: 1 1 20rem; max-width: 34rem; font: inherit; color: var(--text);
    background: var(--surface); border: 1.5px solid var(--border-strong); border-radius: 0;
    padding: 0.55rem 0.9rem;
  }
  .searchbox input:focus-visible { outline-offset: 0; }
  .searchbox .count { margin: 0; color: var(--text-muted); font-size: 0.9rem; }
  /* 结果列表行：与 EntryCard 同语言（顶部分隔线 + hover 指示方块）。
     结果行由搜索脚本动态注入，Astro scoped 样式不会命中，须走 :global() */
  #results { list-style: none; margin: 1.5rem 0 0; padding: 0; }
  #results :global(li) { padding: 1rem 0 1rem 1.1rem; border-top: 1px solid var(--border); position: relative; }
  #results :global(li::before) {
    content: ''; position: absolute; left: 0; top: 1.55rem;
    width: 7px; height: 7px; background: var(--border);
    transition: background-color 0.15s ease;
  }
  #results :global(li:hover::before) { background: var(--accent); }
  /* 来源类型标签（博客/法考/笔记/项目/工具）：直角描边小签，与全站 .idx 同语言。
     结果项由脚本注入，Astro scoped 样式不命中，须走 :global() */
  #results :global(.kind) {
    display: inline-block; margin-right: 0.6rem; vertical-align: 0.12em;
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted);
    border: 1px solid var(--border-strong); padding: 0 0.4rem;
  }
  #results :global(li a) { color: var(--text); font-weight: 700; font-size: 1.05rem; }
  #results :global(li a:hover) { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--accent); }
  #results :global(.snippet) { margin: 0.25rem 0 0; color: var(--text-muted); font-size: 0.95rem; }
  /* 命中词高亮：强调蓝低饱和底，明暗两模式都够对比 */
  #results :global(mark) { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--text); padding: 0 0.15em; }
</style>
</BaseLayout>