---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/format';

// 单页：只渲染最新一期，月更后由新条目自然替换（历史期不上站）。
const current = (await getCollection('now'))
  .sort((a, b) => b.data.period.localeCompare(a.data.period))[0];
const { Content } = await render(current);
---
<BaseLayout title={`Now · ${current.data.period}`} description="此刻正在做的事：备考、构建、写作与待决，按月更新。">
  <article class="prose">
    <p class="meta">{current.data.period} · 更新于 {formatDate(current.data.updated)}</p>
    <h1>Now · {current.data.period}</h1>
    <Content />
    <p class="now-note">
      这是一个 <a href="https://nownownow.com/" target="_blank" rel="noopener">/now 页面</a>：
      只记录我此刻正在做的事，不是完整履历；按月更新，新一期发布后替换本期。这个惯例来自 nownownow.com。
    </p>
  </article>
</BaseLayout>
<style>
  .meta { color: var(--text-muted); }
  .now-note {
    color: var(--text-muted); font-size: 0.9rem;
    border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 2.5rem;
  }
</style>
