---
import { getCollection } from 'astro:content';
import ProjectDetail from '../../templates/ProjectDetail.astro';
import { getProjects } from '../../lib/projects';

/* getStaticPaths 会被 Astro 提升到独立作用域，不能引用 frontmatter 顶层变量；lib 层导入可用 */
export async function getStaticPaths() {
  const projects = await getProjects('zh');
  /* 工具箱与项目库同名互链：详情页给出「工具箱：一键到仓库」外链，两栏不互为孤岛 */
  const toolboxUrlById = new Map((await getCollection('toolbox')).map((t) => [t.id, t.data.url]));
  const enIds = new Set((await getCollection('projectsEn')).map((p) => p.id));
  const postTitleById = new Map((await getCollection('posts')).map((p) => [p.id, p.data.title]));
  return projects.map((p) => ({
    params: { slug: p.id },
    props: {
      project: p,
      lang: 'zh' as const,
      alternate: enIds.has(p.id) ? `/en/projects/${p.id}/` : null,
      toolboxUrl: toolboxUrlById.get(p.id) ?? null,
      /* 同组其他项目：按 order 取前 3 个 */
      sameGroup: projects
        .filter((q) => q.data.group === p.data.group && q.id !== p.id)
        .sort((a, b) => a.data.order - b.data.order)
        .slice(0, 3)
        .map((q) => ({ id: q.id, title: q.data.title })),
      /* 相关博文：frontmatter 的 relatedPosts 存 post id，映射为 /blog/${id}/。
         渲染前核对 id 确实存在于 posts 集合，写错的 id 直接跳过，避免生成死链。 */
      relatedBlog: p.data.relatedPosts
        .filter((id) => postTitleById.has(id))
        .map((id) => ({ id, title: postTitleById.get(id)! })),
    },
  }));
}
---
<ProjectDetail {...Astro.props} />
