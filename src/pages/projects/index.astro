---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { buildSections } from '../../lib/sections';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
const groups = ['法律主线', '法律工具', '工程侧证', '实验'] as const;
/* 分区按页面顺序重编号（只数非空分组），过滤 + 重编号走 lib 层单源实现 */
const sections = buildSections(projects, groups, (p) => p.data.group);
---
<BaseLayout title="项目" description="法律 AI 与工程小件的全量项目清单：每个项目都有边界、机制与可验证的事实。本页讲项目的边界与机制，想要仓库入口去工具箱。">
  <h1>项目</h1>

  <div class="tabs">
    <button class="tab" type="button" data-group="全部" aria-pressed="true">全部 <span class="count">{projects.length}</span></button>
    {sections.map((s) => (
      <button class="tab" type="button" data-group={s.name} aria-pressed="false">{s.name} <span class="count">{s.items.length}</span></button>
    ))}
  </div>

  {sections.map((s) => (
    <section data-group={s.name}>
      <div class="sec-head">
        <span class="sec-no">{s.no}</span>
        <h2>{s.name}<span class="sec-en">Projects</span></h2>
      </div>
      <div class="grid">{s.items.map((p, i) => <ProjectCard project={p} index={i + 1} />)}</div>
    </section>
  ))}

<script>
  /* 分组筛选的公共行为（含可见分区重编号、淡入重放、深链）抽在 src/scripts/tabs.ts */
  import { initTabs } from '../../scripts/tabs';
  initTabs({ tabAttr: 'group', sectionAttr: 'group' });
</script>
<style>
  /* 分组子 tab：与博客页分类 tab 同语言（直角方框，选中墨底反白） */
  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.4rem 0 2rem; }
  .tab {
    font: inherit; font-size: 0.9rem; cursor: pointer;
    color: var(--text); background: var(--surface);
    border: 1px solid var(--border); border-radius: 0;
    padding: 0.3rem 0.85rem;
    /* 触控目标 ≥44px：撑高可点区域，字号与版式不动 */
    display: inline-flex; align-items: center; min-height: 44px;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .tab:hover { border-color: var(--accent); color: var(--accent); }
  .tab[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .tab[aria-pressed='true'] .count { color: var(--bg); opacity: 0.75; }
  .count { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); }
  section { margin: var(--section-gap) 0; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.2rem; }
  /* tab 切换重放入场：一次性 transform/opacity，与全站 fade-up 同曲线；reduce 时不播 */
  @media (prefers-reduced-motion: no-preference) {
    .section-enter { animation: fade-up 0.55s cubic-bezier(0.16, 1, 0.3, 1) both; }
  }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
</BaseLayout>