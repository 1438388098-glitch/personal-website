---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';

const notes = (await getCollection('notes', (n) => !n.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = ['课程论文', '文献研读', '读书笔记'] as const;
---
<BaseLayout title="论文与研读" description="课程论文的存档索引与文献研读清单：论文全文不上站，条目记录研究问题、论点与关键材料。">
  <h1>论文与研读</h1>
  <p class="desc intro">论文全文不上站，这里存档每篇的问题、论点与支撑材料；研读清单持续更新。</p>
  {categories.map((c) => {
    const items = notes.filter((n) => n.data.category === c);
    return items.length > 0 && (
      <section>
        <h2>{c}</h2>
        {items.map((n) => (
          <article class="note-item">
            <p class="meta">{n.data.status} · {formatDate(n.data.date)}</p>
            <h3><a href={`/notes/${n.id}/`}>{n.data.title}</a></h3>
            <p class="desc">{n.data.description}</p>
          </article>
        ))}
      </section>
    );
  })}
</BaseLayout>
<style>
  section { margin: 2rem 0; }
  .note-item { padding: 1.1rem 0; border-top: 1px solid var(--border); }
  .meta { color: var(--text-muted); font-size: 0.85rem; margin: 0 0 0.3rem; }
  h3 { margin: 0 0 0.35rem; font-size: 1.15rem; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--accent); text-decoration: none; }
  .desc { color: var(--text-muted); margin: 0; }
  .intro { margin: 0 0 1.5rem; }
</style>
