---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';
import { byDateDesc } from '../../lib/sort';
import EntryCard from '../../components/EntryCard.astro';

const notes = (await getCollection('notes', (n) => !n.data.draft))
  .sort(byDateDesc((n) => n.data.date));
const categories = [
  { name: '课程论文', en: 'Course Papers' },
  { name: '文献研读', en: 'Readings' },
  { name: '读书笔记', en: 'Book Notes' }
] as const;
/* 分区按页面顺序重编号（sec-head 的 01 递增只数非空分组），仅展示层推导 */
const sections = categories
  .map((c) => ({ ...c, items: notes.filter((n) => n.data.category === c.name) }))
  .filter((s) => s.items.length > 0)
  .map((s, i) => ({ ...s, no: String(i + 1).padStart(2, '0') }));
---
<BaseLayout title="论文与研读" description="课程论文的存档索引与文献研读清单：论文全文不上站，条目记录研究问题、论点与关键材料。">
  <h1>论文与研读</h1>
  {sections.map((s) => (
    <section>
      <div class="sec-head">
        <span class="sec-no">{s.no}</span>
        <h2>{s.name}<span class="sec-en">{s.en}</span></h2>
      </div>
      {s.items.map((n) => (
        <EntryCard
          href={`/notes/${n.id}/`}
          meta={`${n.data.status} · ${formatDate(n.data.date)}`}
          title={n.data.title}
          description={n.data.description}
        />
      ))}
    </section>
  ))}
</BaseLayout>
<style>
  section { margin: 2.5rem 0; }
</style>
