---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import JsonLd from '../../components/JsonLd.astro';
import { formatDate } from '../../lib/format';
import { isVisible } from '../../lib/publish';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('notes', isVisible);
  return articles.map((a) => ({ params: { slug: a.id }, props: { post: a } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, category, status, date } = post.data;
const pageUrl = new URL(Astro.url.pathname, SITE.url).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: pageUrl,
  datePublished: date.toISOString(),
  inLanguage: 'zh-CN',
  articleSection: category,
  author: { '@type': 'Person', name: SITE.author, url: new URL('/about/', SITE.url).toString() }
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', SITE.url).toString() },
    { '@type': 'ListItem', position: 2, name: '论文与研读', item: new URL('/notes/', SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl }
  ]
};
---
<BaseLayout title={title} description={description} type="article" publishedTime={date} alternate={`/en/notes/${post.id}/`}>
  <div class="doc">
    <article class="prose">
      <p class="meta">{category} · {status} · <span class="mono">{formatDate(date)}</span></p>
      <h1>{title}</h1>
      <Content />
      <p><a href="/notes/">← 论文与研读</a></p>
    </article>
    <Toc headings={headings} />
  </div>
  <JsonLd data={jsonLd} />
  <JsonLd data={breadcrumb} />
</BaseLayout>
<style>
  .meta { color: var(--text-muted); }
</style>
