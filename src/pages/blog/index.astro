---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { POST_CATEGORIES } from '../../lib/categories';

const posts = await getPublishedPosts();
const categories = POST_CATEGORIES;
const countOf = (c: string) => posts.filter((p) => p.data.category === c).length;
---
<BaseLayout title="博客" description="法律 × AI 的工程方法论、技术笔记与法学随笔，另有游戏手记、杂谈、经济观察与热点快评。">
  <h1>博客</h1>

  <div class="tabs">
    <button class="tab" type="button" data-cat="全部" aria-pressed="true">全部<span class="count">{posts.length}</span></button>
    {categories.map((c) => (
      <button class="tab" type="button" data-cat={c} aria-pressed="false">{c}<span class="count">{countOf(c)}</span></button>
    ))}
  </div>

  {/*
    两种视图：「全部」按发布时间平铺（默认），点分类 tab 才显示分板块视图。
    section 服务端先藏、由脚本按选中分类展开；平铺列表的每张卡片自带分类角标，上下文不丢。
  */}
  <div data-view="all">
    {posts.map((p) => <PostCard post={p} />)}
  </div>

  {categories.map((c) => {
    const items = posts.filter((p) => p.data.category === c);
    return (
      <section data-category={c} data-empty={items.length === 0 ? 'true' : undefined} hidden>
        <h2>{c}</h2>
        {items.map((p) => <PostCard post={p} />)}
      </section>
    );
  })}

  <p class="essay-note" data-note>法学向的长文收录在<a href="/notes/">论文与研读</a>栏：竞业限制的实证研究、布雷克顿与罗马法，都在那里。</p>
  <p class="empty-note" data-empty-note hidden>这个分类还没攒出稿子，先看看别的。</p>
<style>
  /* 分类 tab：直角小方框，选中态墨底反白（v3 语言） */
  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.4rem 0 2rem; }
  .tab {
    font: inherit; font-size: 0.9rem; cursor: pointer;
    color: var(--text); background: var(--surface);
    border: 1px solid var(--border); border-radius: 0;
    padding: 0.3rem 0.85rem;
    /* 触控目标 ≥44px：撑高可点区域，字号与版式不动 */
    display: inline-flex; align-items: center; min-height: 44px;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .tab:hover { border-color: var(--accent); color: var(--accent); }
  .tab[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .tab[aria-pressed='true'] .count { color: var(--bg); opacity: 0.75; }
  /* 计数与中文分类之间用固定间距，不靠字面空格（等宽字侧边距宽，缝会随字数浮动） */
  .count { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); margin-left: 0.35em; }
  section { margin: var(--section-gap) 0; }
  section > h2 { font-size: 1.3rem; }
  .essay-note, .empty-note { color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 1rem; }
  .empty-note { border-top: none; padding-top: 0; }
</style>
<script>
  /* 分类筛选的公共行为（含可访问性、深链、平铺/分板块切换）抽在 src/scripts/tabs.ts */
  import { initTabs } from '../../scripts/tabs';
  initTabs({ tabAttr: 'cat', sectionAttr: 'category' });
</script>
</BaseLayout>