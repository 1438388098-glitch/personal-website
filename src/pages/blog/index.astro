---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { byDateDesc } from '../../lib/sort';

/* 定时发布：未到 pubDate 的文章不进列表 */
const isPublished = (p: { data: { draft: boolean; pubDate: Date } }) =>
  !p.data.draft && p.data.pubDate.valueOf() <= Date.now();
const posts = (await getCollection('posts', isPublished)).sort(byDateDesc((p) => p.data.pubDate));
const categories = ['工程方法论', '技术笔记', '法学随笔', '游戏手记', '杂谈', '经济观察', '热点快评'] as const;
const countOf = (c: string) => posts.filter((p) => p.data.category === c).length;
---
<BaseLayout title="博客" description="法律 × AI 的工程方法论、技术笔记与法学随笔，另有游戏手记、杂谈、经济观察与热点快评。">
  <h1>博客</h1>

  <div class="tabs" role="tablist" aria-label="按分类筛选">
    <button class="tab" type="button" data-cat="全部" aria-pressed="true">全部 <span class="count">{posts.length}</span></button>
    {categories.map((c) => (
      <button class="tab" type="button" data-cat={c} aria-pressed="false">{c} <span class="count">{countOf(c)}</span></button>
    ))}
  </div>

  {categories.map((c) => {
    const items = posts.filter((p) => p.data.category === c);
    return (
      <section data-category={c} data-empty={items.length === 0 ? 'true' : undefined} hidden={items.length === 0}>
        <h2>{c}</h2>
        {items.map((p) => <PostCard post={p} />)}
      </section>
    );
  })}

  <p class="essay-note" data-note>法学向的长文目前沉淀在<a href="/notes/">论文与研读</a>栏：竞业限制的实证研究、布雷克顿与罗马法，都在那里。</p>
  <p class="empty-note" data-empty-note hidden>这个分类还没攒出稿子，先看看别的。</p>
</BaseLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-category]'));
  const essayNote = document.querySelector<HTMLElement>('[data-note]');
  const emptyNote = document.querySelector<HTMLElement>('[data-empty-note]');

  const select = (cat: string) => {
    tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.cat === cat)));
    let shown = 0;
    sections.forEach((s) => {
      const visible = s.dataset.category === cat;
      s.hidden = !visible;
      if (visible) shown += 1;
    });
    const catEmpty = cat !== '全部' && shown === 0;
    if (emptyNote) emptyNote.hidden = !catEmpty;
    if (essayNote) essayNote.hidden = cat !== '全部';
    history.replaceState(null, '', cat === '全部' ? location.pathname : `#${cat}`);
  };

  tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.cat ?? '全部')));

  const fromHash = tabs.map((t) => t.dataset.cat).find((c) => c && location.hash === `#${c}`);
  if (fromHash) select(fromHash);
</script>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0 0.25rem; }
  .tab {
    border: 1px solid var(--border-strong); border-radius: 999px; background: var(--bg);
    color: var(--text-muted); padding: 0.3rem 0.85rem; font-size: 0.9rem; cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .tab:hover { border-color: var(--accent); color: var(--accent); }
  .tab[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .tab[aria-pressed='true']:hover { color: #fff; }
  .count { font-size: 0.8rem; opacity: 0.75; }
  section { margin: 2rem 0; }
  .essay-note { color: var(--text-muted); margin-top: 2.5rem; }
  .empty-note { color: var(--text-muted); margin-top: 2.5rem; }
</style>
