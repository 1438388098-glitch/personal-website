---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import JsonLd from '../../components/JsonLd.astro';
import { formatDate } from '../../lib/format';
import { getPublishedPosts, getAdjacent } from '../../lib/posts';
import { SITE, SITE_PATHS } from '../../lib/site';

/* getStaticPaths 会被 Astro 提升到独立作用域，不能引用 frontmatter 顶层变量；lib 层导入可用 */
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, category, pubDate, tags, image } = post.data;
const shareImage = new URL(image ?? SITE_PATHS.ogImage, SITE.url).toString();
/* 相邻文章按发布日期排序：新一篇 / 旧一篇（含定时发布过滤） */
const sorted = await getPublishedPosts();
const { newer, older } = getAdjacent(sorted, post.id);
/* 相关文章：共同标签多的在前，其次同分类，再次按时间新；排除自身，最多 4 篇。
   只在有共同标签或同分类时入选，避免为凑数推不相干的文章。 */
const related = sorted
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    shared: p.data.tags.filter((t) => tags.includes(t)).length,
    sameCategory: p.data.category === category ? 1 : 0
  }))
  .filter((x) => x.shared > 0 || x.sameCategory > 0)
  .sort(
    (a, b) =>
      b.shared - a.shared ||
      b.sameCategory - a.sameCategory ||
      b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )
  .slice(0, 4)
  .map((x) => x.post);
const pageUrl = new URL(Astro.url.pathname, SITE.url).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  /* Google 文章富结果要求 image 与 canonical url；分享图暂用全站默认 og 图 */
  image: [shareImage],
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  inLanguage: 'zh-CN',
  /* 栏目写进 articleSection，供富结果与聚合器识别；站点分组即博客分类 */
  articleSection: category,
  author: { '@type': 'Person', name: SITE.author, url: new URL('/about/', SITE.url).toString() },
  publisher: { '@type': 'Organization', name: SITE.title, url: SITE.url },
  keywords: tags.join(', ')
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', SITE.url).toString() },
    { '@type': 'ListItem', position: 2, name: '博客', item: new URL('/blog/', SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl }
  ]
};
---
<BaseLayout title={title} description={description} type="article" image={image} publishedTime={post.data.pubDate}>
  <div class="doc">
    <div class="col">
      <article class="prose">
        <p class="meta">
          {category} · <span class="mono">{formatDate(pubDate)}</span>
          {tags.length > 0 && <span class="tag-row"> · {tags.map((t) => <a class="tag-link" href={`/tags/${t}/`}>#{t}</a>)}</span>}
        </p>
        <h1>{title}</h1>
        <Content />
        <p><a href="/blog/">← 全部文章</a></p>
      </article>
      {(newer || older) && (
        <nav class="adjacent" aria-label="相邻文章">
          {newer && <a class="adj-link" href={`/blog/${newer.id}/`}>← 较新：{newer.data.title}</a>}
          {older && <a class="adj-link adj-next" href={`/blog/${older.id}/`}>较旧：{older.data.title} →</a>}
        </nav>
      )}
      {related.length > 0 && (
        <section class="related" aria-label="相关文章">
          <div class="sec-head"><h2>相关文章<span class="sec-en">Related</span></h2></div>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/blog/${r.id}/`}>{r.data.title}</a>
                <span class="mono">{formatDate(r.data.pubDate)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
    <Toc headings={headings} />
  </div>
  <JsonLd data={jsonLd} />
  <JsonLd data={breadcrumb} />
</BaseLayout>
<style>
  .meta { color: var(--text-muted); }
  .tag-row { display: inline-flex; gap: 0.6rem; margin-left: 0.35rem; }
  .tag-link { color: var(--text-muted); }
  .tag-link:hover { color: var(--accent); text-decoration: none; }
  .adjacent {
    margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .adj-link { color: var(--text-muted); }
  .adj-next { text-align: right; }
  /* 相关文章：同主题（共同标签/同分类）的横向发现出口，避免长文读完是死胡同 */
  .related { margin-top: 3rem; }
  .related ul { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .related li { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .related a { color: var(--text); }
  .related a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--accent); }
  .related .mono { color: var(--text-muted); font-size: 0.85rem; flex: none; }
</style>
