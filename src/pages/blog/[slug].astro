---
import { render } from 'astro:content';
import PostDetail from '../../templates/PostDetail.astro';
import { getPublishedPosts } from '../../lib/posts';
import { getCollection } from 'astro:content';

/* getStaticPaths 会被 Astro 提升到独立作用域，不能引用 frontmatter 顶层变量；lib 层导入可用 */
export async function getStaticPaths() {
  const posts = await getPublishedPosts('zh');
  const enIds = new Set((await getCollection('postsEn')).map((p) => p.id));
  return posts.map((p) => ({
    params: { slug: p.id },
    props: {
      post: p,
      lang: 'zh' as const,
      alternate: enIds.has(p.id) ? `/en/blog/${p.id}/` : null,
    },
  }));
}
---
<PostDetail {...Astro.props} />
