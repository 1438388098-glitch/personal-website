---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';
import { byDateDesc } from '../../lib/sort';
import { EXAM_AGG } from '../../lib/exam-progress';
import { HOME_METRICS } from '../../lib/metrics';

const articles = (await getCollection('exam', (e) => !e.data.draft))
  .sort(byDateDesc((e) => e.data.date));

/* 输出数字从 lib 层单源拼装，不在此页复述字面量 */
const judbench = HOME_METRICS.find((m) => m.source === 'cn-judbench');
const judbenchPacks = judbench?.detail.split('，')[1] ?? '12 个评测包';
const judbenchCount = judbench?.value ?? '323';

// 备考一圈的先后顺序：客观题错题从竹马来，从整理错题起步，主观题收尾；产出数据均可溯源到对应案例页
const stages = [
  {
    step: '01',
    stage: '错题整理',
    tool: 'zhuma-fakao-review',
    href: '/projects/zhuma-fakao-review/',
    ai: '客观题的错题自动抓全，审查后按科目装订成可背诵的笔记 PDF',
    output: `${EXAM_AGG.wrongQuestions.toLocaleString('en-US')} 道错题 → 18 册 PDF，约 ${EXAM_AGG.minutesPerRound} 分钟一轮`
  },
  {
    step: '02',
    stage: '法条检索',
    tool: 'statute-rag',
    href: '/projects/statute-rag/',
    ai: '只回答带条号的法条原文，检索不到就明说',
    output: '177 道模拟测试题，98.9% 检中正确条文'
  },
  {
    step: '03',
    stage: '主观题刷题',
    tool: 'fakao-shuati',
    href: 'https://github.com/1438388098-glitch/fakao-shuati',
    ai: '自托管的主观题练习平台，作答、复盘、错题本都在自己机器上',
    output: '深度复盘报告自动生成'
  },
  {
    step: '04',
    stage: '主观题判分',
    tool: 'fakao-grader',
    href: '/projects/fakao-grader/',
    ai: '独立的判分 Agent：按官方采分点逐点判，没把握的判定强制复核',
    output: '✓ / △ / ✗ 三级判定，±3 分考场预估带'
  },
  {
    step: '05',
    stage: 'AI 能力评测',
    tool: 'cn-judbench（法衡）',
    href: '/projects/cn-judbench/',
    ai: '评分标准提前公开，判分照标准机器来——AI 先测行不行，再进流程',
    output: `${judbenchPacks} · ${judbenchCount} 道公开题`
  },
  {
    step: '06',
    stage: '工具制造',
    tool: 'Claude Code 等 AI 编码协作',
    href: '/toolbox/',
    ai: '上面每个工具都是这么造出来的：带测试、带数据、带失败记录',
    output: '11 个公开仓库，全部可查'
  }
];
---
<BaseLayout title="法考 × AI" description="把备考拆成六个环节，每个环节一个自建 AI 工具：错题变笔记、法条检索必带条文引用、主观题自练自判、AI 先评测再上岗，产出数据全部公开可查。">
  <h1>法考 × AI</h1>
  <p class="intro">
    客观题在竹马刷，错题是唯一属于我的数据——整理工作从这里开始。
    错题变笔记、法条随时查、主观题自练自判，AI 本身先测过再用。
    下面六个环节按备考的先后排，页尾两篇实录展开其中两个。
  </p>
  <section aria-label="备考环节与自建工具">
    <h2>六个环节，按备考顺序</h2>
    <div class="stage-grid">
      {stages.map((s) => (
        <div class="card stage-card">
          <p class="step" aria-hidden="true">{s.step}</p>
          <p class="stage-name">{s.stage}</p>
          <a class="tool" href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener' : undefined}>{s.tool}</a>
          <p class="ai">{s.ai}</p>
          <p class="output">{s.output}</p>
        </div>
      ))}
    </div>
  </section>
  {articles.length > 0 && (
    <section>
      <h2>实录文章</h2>
      {articles.map((a) => (
        <article class="exam-item">
          <p class="meta">{a.data.type}{a.data.subject && ` · ${a.data.subject}`} · {formatDate(a.data.date)}</p>
          <h3><a href={`/exam/${a.id}/`}>{a.data.title}</a></h3>
          <p class="desc">{a.data.description}</p>
        </article>
      ))}
    </section>
  )}
</BaseLayout>
<style>
  .intro { color: var(--text-muted); max-width: 46rem; }
  section { margin: 2rem 0; }
  .stage-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  .stage-card { padding: 1.15rem 1.3rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .step { margin: 0; font-family: var(--font-serif); font-weight: 700; color: var(--accent); font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  .stage-name { margin: 0; font-family: var(--font-serif); font-weight: 700; }
  .tool {
    align-self: flex-start; font-size: 0.82rem; line-height: 1.7;
    border: 1px solid var(--border-strong); border-radius: 999px; padding: 0.15rem 0.6rem;
    min-height: 24px; display: inline-flex; align-items: center;
    color: var(--accent);
    transition: border-color 0.15s ease;
  }
  .tool:hover { border-color: var(--accent); text-decoration: none; }
  .ai { margin: 0; color: var(--text); font-size: 0.95rem; }
  .output { margin: 0; color: var(--text-muted); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .exam-item { padding: 1.1rem 0; border-top: 1px solid var(--border); }
  .meta { color: var(--text-muted); font-size: 0.85rem; margin: 0 0 0.3rem; }
  h3 { margin: 0 0 0.35rem; font-size: 1.15rem; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--accent); text-decoration: none; }
  .desc { color: var(--text-muted); margin: 0; }
  @media (max-width: 720px) {
    .stage-grid { grid-template-columns: 1fr; }
  }
</style>
