---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';
import { byDateDesc } from '../../lib/sort';
import { isVisible } from '../../lib/publish';
import { EXAM_AGG } from '../../lib/exam-progress';
import { figure } from '../../lib/metrics';
import { SELF_CHECK_AGG } from '../../data/self-check';
import EntryCard from '../../components/EntryCard.astro';

const articles = (await getCollection('exam', isVisible))
  .sort(byDateDesc((e) => e.data.date));

/* 输出数字从 lib 层单源取结构化 figures，不在此页复述字面量 */
const publicRepos = (await getCollection('toolbox')).length;

// 备考一圈的先后顺序：先有计划与打卡这个底盘，客观题错题从竹马来，主观题刷完先自查再交 AI 判分收尾；产出数据均可溯源到对应案例页
const stages = [
  {
    step: '01',
    stage: '计划打卡',
    tool: 'fakao-tracker',
    href: '/projects/fakao-tracker/',
    ai: '今天该学什么不用自己排：内置多阶段备考计划，开站自动铺课表，做完勾掉、晚上打卡；已上线，手机电脑直接打卡',
    output: `${figure('fakao-tracker', 'planStages')}自动铺开，${figure('fakao-tracker', 'dailySlots')}，数据不出本机`
  },
  {
    step: '02',
    stage: '错题整理',
    tool: 'zhuma-fakao-review',
    href: '/projects/zhuma-fakao-review/',
    ai: '客观题的错题自动抓全，审查后按科目装订成可背诵的笔记 PDF',
    output: `${EXAM_AGG.wrongQuestions.toLocaleString('en-US')} 道错题 → ${EXAM_AGG.pdfBooklets} 册 PDF，约 ${EXAM_AGG.minutesPerRound} 分钟一轮`
  },
  {
    step: '03',
    stage: '法条检索',
    tool: 'statute-rag',
    href: '/projects/statute-rag/',
    ai: '只回带条号的法条原文，检索不到就明说；已上线可免安装直接查',
    output: `${figure('statute-rag', 'questions')}，${figure('statute-rag', 'hitRate')} 检中正确条文`
  },
  {
    step: '04',
    stage: '主观题刷题',
    tool: 'fakao-shuati',
    href: '/projects/fakao-shuati/',
    ai: '自托管的主观题练习平台，作答、复盘、错题本都在自己机器上',
    output: '深度复盘报告自动生成'
  },
  {
    step: '05',
    stage: '主观题自查',
    tool: '主观题采分点自查清单',
    href: '/exam/checklist/',
    ai: '答完先自查再交 AI：按结论 / 依据 / 分析三类点逐条过，没勾的就是丢分点',
    output: `${SELF_CHECK_AGG.items} 条自查项 · ${SELF_CHECK_AGG.subjects} 个科目，勾选只存本机`
  },
  {
    step: '06',
    stage: '主观题判分',
    tool: 'fakao-grader',
    href: '/projects/fakao-grader/',
    ai: '独立的判分 Agent：按官方采分点逐点判，没把握的判定强制复核',
    output: '✓ / △ / ✗ 三级判定，±3 分考场预估带'
  },
  {
    step: '07',
    stage: 'AI 能力评测',
    tool: 'cn-judbench（法衡）',
    href: '/projects/cn-judbench/',
    ai: '评分标准提前公开，判分照标准机器来：AI 先测行不行，再进流程',
    output: `${figure('cn-judbench', 'packs')} · ${figure('cn-judbench', 'questions')}`
  },
  {
    step: '08',
    stage: '工具制造',
    tool: 'Claude Code 等 AI 编码协作',
    href: '/toolbox/',
    ai: '上面每个工具都是这么造出来的：带测试、带数据、带失败记录',
    output: `${publicRepos} 个公开仓库，全部可查`
  }
];
---
<BaseLayout title="法考 × AI" description="把备考拆成八个环节，每个环节一个自建 AI 工具：计划打卡、错题变笔记、法条检索必带条文引用、主观题自练自查自判、AI 先评测再上岗，产出数据全部公开可查。">
  <h1>法考 × AI</h1>
  <section aria-label="备考环节与自建工具">
    <div class="sec-head">
      <span class="sec-no">01</span>
      <h2>八个环节，按备考顺序<span class="sec-en">Workflow</span></h2>
    </div>
    <div class="stage-grid">
      {stages.map((s) => (
        <div class="card stage-card">
          <p class="stage-head">
            <span class="step mono" aria-hidden="true">{s.step}</span>
            <span class="stage-name">{s.stage}</span>
          </p>
          <a
            class="tool"
            href={s.href}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={s.href.startsWith('http') ? `${s.tool}（在新窗口打开）` : undefined}
          >{s.tool}</a>
          <p class="ai">{s.ai}</p>
          <p class="output mono">{s.output}</p>
        </div>
      ))}
    </div>
  </section>
  {articles.length > 0 && (
    <section>
      <div class="sec-head">
        <span class="sec-no">02</span>
        <h2>实录文章<span class="sec-en">Field Notes</span></h2>
      </div>
      {articles.map((a) => (
        <EntryCard
          href={`/exam/${a.id}/`}
          meta={`${a.data.type} · ${formatDate(a.data.date)}`}
          title={a.data.title}
          description={a.data.description}
        />
      ))}
    </section>
  )}
</BaseLayout>
<style>
  section { margin: var(--section-gap) 0; }
  .stage-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.2rem; }
  .stage-card { padding: 1.25rem 1.4rem; display: flex; flex-direction: column; gap: 0.45rem; }
  /* 头部一行：编号框 + 环节名并排。编号框与 ProjectCard 的卡片序号同一套墨色描边方框，
     蓝色留给区块编号 .sec-no；hover 反色是这张卡唯一的小图形反馈 */
  .stage-head { display: flex; align-items: center; gap: 0.65rem; margin: 0; }
  .step {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 2rem; height: 1.5rem; padding: 0 0.4rem; margin: 0;
    font-weight: 700; color: var(--text); font-size: 0.82rem;
    border: 1.5px solid var(--border-strong);
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  /* 反色用 --bg 而非白：暗色下强调蓝变浅蓝，白字对比不足 */
  .stage-card:hover .step { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  /* 700：Noto Sans SC 无 800 面，显式 800 会回落 900，与全站小标题口径一致 */
  .stage-name { margin: 0; font-weight: 700; font-size: var(--fs-card-title); }
  /* 工具名不再描框：中文工具名装进英文等宽描边框里两头不是，降为 ProjectCard repo 行
     同语言的 meta 链接（muted，hover 转蓝）；min-height 保留 ≥44px 触控目标 */
  .tool {
    align-self: flex-start; font-size: 0.9rem;
    min-height: 44px; display: inline-flex; align-items: center;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }
  .tool:hover { color: var(--accent); text-decoration: none; }
  .ai { margin: 0; color: var(--text); font-size: 0.95rem; }
  /* 数据行钉底：与 ProjectCard 的 metrics 脚注同一套（margin-top:auto + 细上边线），
     同排卡片不管描述几行，数据基线都落在同一条线上，不再出现下半张空白 */
  .output { margin: auto 0 0; padding-top: 0.7rem; border-top: 1px solid var(--border); color: var(--text-muted); font-size: 0.82rem; }
  @media (max-width: 720px) {
    .stage-grid { grid-template-columns: 1fr; }
  }
</style>
