---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';
import { byDateDesc } from '../../lib/sort';
import { isVisible } from '../../lib/publish';
import { EXAM_AGG } from '../../lib/exam-progress';
import { figure } from '../../lib/metrics';
import { SELF_CHECK_AGG } from '../../data/self-check';
import EntryCard from '../../components/EntryCard.astro';

const articles = (await getCollection('exam', isVisible))
  .sort(byDateDesc((e) => e.data.date, (e) => e.id));

/* 输出数字从 lib 层单源取结构化 figures，不在此页复述字面量 */
const publicRepos = (await getCollection('toolbox')).length;

// 备考一圈的先后顺序：先有计划与打卡这个底盘，客观题错题从竹马来，主观题刷完先自查再交 AI 判分收尾；产出数据均可溯源到对应案例页
// wide 标记尾部两环：AI 评测与工具制造是质量保障层的元环节，六宫格之后用两条通栏横排收尾，读法从上下堆变左中右
const stages: { step: string; stage: string; tool: string; href: string; ai: string; output: string; wide?: boolean }[] = [
  {
    step: '01',
    stage: '计划打卡',
    tool: 'fakao-tracker',
    href: '/projects/fakao-tracker/',
    ai: '今天该学什么不用自己排：内置多阶段备考计划，开站自动铺课表，做完勾掉、晚上打卡；已上线，手机电脑直接打卡',
    output: `${figure('fakao-tracker', 'planStages')}自动铺开，${figure('fakao-tracker', 'dailySlots')}，数据不出本机`
  },
  {
    step: '02',
    stage: '错题整理',
    tool: 'zhuma-fakao-review',
    href: '/projects/zhuma-fakao-review/',
    ai: '客观题的错题自动抓全，审查后按科目装订成可背诵的笔记 PDF',
    output: `${EXAM_AGG.wrongQuestions.toLocaleString('en-US')} 道错题 → ${EXAM_AGG.pdfBooklets} 册 PDF，约 ${EXAM_AGG.minutesPerRound} 分钟一轮`
  },
  {
    step: '03',
    stage: '法条检索',
    tool: 'statute-rag',
    href: '/projects/statute-rag/',
    ai: '只回带条号的法条原文，检索不到就明说；已上线可免安装直接查',
    output: `${figure('statute-rag', 'questions')}，${figure('statute-rag', 'hitRate')} 检中正确条文`
  },
  {
    step: '04',
    stage: '主观题刷题',
    tool: 'fakao-shuati',
    href: '/projects/fakao-shuati/',
    ai: '自托管的主观题练习平台，作答、复盘、错题本都在自己机器上',
    output: '深度复盘报告自动生成'
  },
  {
    step: '05',
    stage: '主观题自查',
    tool: '主观题采分点自查清单',
    href: '/exam/checklist/',
    ai: '答完先自查再交 AI：按结论 / 依据 / 分析三类点逐条过，没勾的就是丢分点',
    output: `${SELF_CHECK_AGG.items} 条自查项 · ${SELF_CHECK_AGG.subjects} 个科目，勾选只存本机`
  },
  {
    step: '06',
    stage: '主观题判分',
    tool: 'fakao-grader',
    href: '/projects/fakao-grader/',
    ai: '独立的判分 Agent：按官方采分点逐点判，没把握的判定强制复核',
    output: '✓ / △ / ✗ 三级判定，±3 分考场预估带'
  },
  {
    step: '07',
    stage: 'AI 能力评测',
    tool: 'cn-judbench（法衡）',
    href: '/projects/cn-judbench/',
    ai: '评分标准提前公开，判分照标准机器来：AI 先测行不行，再进流程',
    output: `${figure('cn-judbench', 'packs')} · ${figure('cn-judbench', 'questions')}`,
    wide: true
  },
  {
    step: '08',
    stage: '工具制造',
    tool: 'Claude Code 等 AI 编码协作',
    href: '/toolbox/',
    ai: '上面每个工具都是这么造出来的：带测试、带数据、带失败记录',
    output: `${publicRepos} 个公开仓库，全部可查`,
    wide: true
  }
];
---
<BaseLayout title="法考 × AI" description="把备考拆成八个环节，每个环节一个自建 AI 工具：计划打卡、错题变笔记、法条检索必带条文引用、主观题自练自查自判、AI 先评测再上岗，产出数据全部公开可查。" alternate="/en/exam/">
  <h1>法考 × AI</h1>
  <section aria-label="备考环节与自建工具">
    <div class="sec-head">
      <span class="sec-no">01</span>
      <h2>八个环节，按备考顺序<span class="sec-en">Workflow</span></h2>
    </div>
    <div class="stage-grid">
      {stages.map((s) => (
        <div class={`card stage-card${s.wide ? ' stage-card--wide' : ''}`}>
          <span class="stage-no" aria-hidden="true">{s.step}</span>
          <div class="stage-lead">
            <p class="stage-name">{s.stage}</p>
            <a
              class="tool"
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={s.href.startsWith('http') ? `${s.tool}（在新窗口打开）` : undefined}
            >{s.tool}</a>
          </div>
          <p class="ai">{s.ai}</p>
          <p class="output mono">{s.output}</p>
        </div>
      ))}
    </div>
  </section>
  {articles.length > 0 && (
    <section>
      <div class="sec-head">
        <span class="sec-no">02</span>
        <h2>实录文章<span class="sec-en">Field Notes</span></h2>
      </div>
      {articles.map((a) => (
        <EntryCard
          href={`/exam/${a.id}/`}
          meta={`${a.data.type} · ${formatDate(a.data.date)}`}
          title={a.data.title}
          description={a.data.description}
        />
      ))}
    </section>
  )}
</BaseLayout>
<style>
  section { margin: var(--section-gap) 0; }
  .stage-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.2rem; }
  .stage-card { position: relative; padding: 1.25rem 1.4rem; display: flex; flex-direction: column; gap: 0.45rem; }
  /* 环节序号放大成描边幽灵数字：静态只有极淡的轮廓压住右上角，hover 填充强调蓝。
     「编号」是设计规范里点名允许用蓝的小元素，这里让八个编号成为页面的主图形节奏 */
  .stage-no {
    position: absolute; top: 0.8rem; right: 1rem;
    font-family: var(--font-display); font-weight: 900; font-size: 2.5rem; line-height: 1;
    color: var(--border); user-select: none; pointer-events: none;
    transition: color 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @supports (-webkit-text-stroke: 1.5px #000) {
    .stage-no { color: transparent; -webkit-text-stroke: 1.5px var(--border); }
  }
  .stage-card:hover .stage-no { color: var(--accent); -webkit-text-stroke-color: var(--accent); }
  .stage-lead { display: flex; flex-direction: column; align-items: flex-start; gap: 0.1rem; }
  /* 700：Noto Sans SC 无 800 面，显式 800 会回落 900，与全站小标题口径一致 */
  .stage-name { margin: 0; font-weight: 700; font-size: var(--fs-card-title); }
  /* 工具名回归全站链接蓝（a 本色），hover 加下划线；min-height 保留 ≥44px 触控目标 */
  .tool {
    align-self: flex-start; font-size: 0.9rem;
    min-height: 44px; display: inline-flex; align-items: center;
    color: var(--accent);
    transition: color 0.15s ease;
  }
  .tool:hover { text-decoration: underline; text-underline-offset: 4px; }
  .ai { margin: 0; color: var(--text); font-size: 0.95rem; }
  /* 数据行钉底：与 ProjectCard 的 metrics 脚注同一套（margin-top:auto + 细上边线），
     同排卡片不管描述几行，数据基线都落在同一条线上，不再出现下半张空白 */
  .output { margin: auto 0 0; padding-top: 0.7rem; border-top: 1px solid var(--border); color: var(--text-muted); font-size: 0.82rem; }
  /* 尾环（工具制造）是元环节：通栏横排，读法从上下堆变左中右；
     padding-right 给幽灵数字留出专属列，数据行不再钉底改居右。
     全宽行不做 hover 抬升：一整行上下抖动视觉上就是「晃」，只留数字填充与链接反馈 */
  .stage-card--wide { grid-column: 1 / -1; flex-direction: row; align-items: center; gap: 2rem; padding-right: 6.5rem; }
  .stage-card--wide:hover { transform: none; box-shadow: none; }
  .stage-card--wide .stage-lead { flex: 0 0 15rem; }
  .stage-card--wide .ai { flex: 1; }
  .stage-card--wide .output { margin: 0; padding: 0; border-top: none; white-space: nowrap; }
  @media (max-width: 720px) {
    .stage-grid { grid-template-columns: 1fr; }
    /* 窄屏通栏尾环回到上下堆，数据行重新钉底 */
    .stage-card--wide { flex-direction: column; align-items: flex-start; gap: 0.45rem; padding-right: 1.4rem; }
    .stage-card--wide .output { margin: auto 0 0; padding-top: 0.7rem; border-top: 1px solid var(--border); white-space: normal; align-self: stretch; }
  }
</style>
