---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EXAM_AGG, EXAM_DATA_AS_OF } from '../../lib/exam-progress';
import { formatDate } from '../../lib/format';

const articles = (await getCollection('exam', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const cards = [
  { label: '科目', value: `${EXAM_AGG.subjects}`, detail: '客观题一 9 + 客观题二 9' },
  { label: '处理单元', value: `${EXAM_AGG.units}`, detail: '每单元不超过 55 题' },
  { label: '唯一错题', value: `${EXAM_AGG.wrongQuestions}`, detail: '按 id 去重，带完整官方解析' },
  { label: '单轮抓取', value: `约 ${EXAM_AGG.minutesPerRound} 分钟`, detail: '全量错题一次抓完，断点续跑' }
];
---
<BaseLayout title="法考备考" description="备战国家统一法律职业资格考试：以错题为驱动的方法论与备考记录。">
  <h1>法考备考</h1>
  <p class="intro">备战国家统一法律职业资格考试，以错题为驱动。数据截至 {EXAM_DATA_AS_OF}，取自 zhuma-fakao-review 一次完整运行的实测规模。</p>
  <section class="metrics" aria-label="错题规模">
    {cards.map((c) => (
      <div class="metric">
        <span class="value">{c.value}</span>
        <span class="label">{c.label}</span>
        <span class="detail">{c.detail}</span>
      </div>
    ))}
  </section>
  {articles.length > 0 && (
    <section>
      <h2>文章</h2>
      {articles.map((a) => (
        <article class="exam-item">
          <p class="meta">{a.data.type}{a.data.subject && ` · ${a.data.subject}`} · {formatDate(a.data.date)}</p>
          <h3><a href={`/exam/${a.id}/`}>{a.data.title}</a></h3>
          <p class="desc">{a.data.description}</p>
        </article>
      ))}
    </section>
  )}
</BaseLayout>
<style>
  .intro { color: var(--text-muted); }
  .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin: 1.5rem 0; }
  .metric { background: var(--bg); padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .value { font-size: 1.9rem; font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
  .label { font-weight: 600; }
  .detail { color: var(--text-muted); font-size: 0.85rem; }
  section { margin: 2rem 0; }
  .exam-item { padding: 1.1rem 0; border-top: 1px solid var(--border); }
  .meta { color: var(--text-muted); font-size: 0.85rem; margin: 0 0 0.3rem; }
  h3 { margin: 0 0 0.35rem; font-size: 1.15rem; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--accent); text-decoration: none; }
  .desc { color: var(--text-muted); margin: 0; }
  @media (max-width: 720px) { .metrics { grid-template-columns: repeat(2, 1fr); } }
</style>
