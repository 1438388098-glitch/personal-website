---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
// TODO(资产): 个人照片位，用户提供后插入（本页头部右侧信息面板上方，1:1，max-width 180px）
---
<BaseLayout title={`关于 · ${SITE.title}`} description={`${SITE.author}的个人介绍与简历：法学与经济学双学位、三段法律实习、法律 × AI 工程实践。`}>
  <section class="about-hero">
    <div>
      <h1>关于</h1>
      <div class="intro">
        <p>
          我是胡圣炜，广东韶关人，中南财经政法大学法学与经济学双学位本科生，
          成长于粤北多语言环境（普通话、粤语、客家话），这让我习惯在不同语境间准确转译，
          也让我对「表述精确」有职业级的执念。
        </p>
        <p>
          我的方向是法律与 AI 的交叉地带：法律文本的结构化、检索与评估。
          我相信法律场景的 AI 输出不能靠蒙，所以我的项目都围着同一件事转：
          让模型的每句话可复核、可评估、可追溯。工具上重度使用 Claude Code 等 AI 编码协作，
          并把工程纪律（测试、指标、失败案例）带进每一个法律项目。
        </p>
      </div>
    </div>
    <aside class="facts" aria-label="关键信息">
      <div class="fact-row"><span class="k">学校</span><span class="v">中南财经政法大学</span></div>
      <div class="fact-row"><span class="k">学位</span><span class="v">法学 &amp; 经济学 双学位</span></div>
      <div class="fact-row"><span class="k">学年</span><span class="v mono">2023.09 - 2027.06</span></div>
      <div class="fact-row"><span class="k">法学均分</span><span class="v mono">87 / 100</span></div>
      <div class="fact-row"><span class="k">状态</span><span class="v">法考备考中</span></div>
      <div class="fact-row"><span class="k">语言</span><span class="v">普通话 · 粤语 · IELTS 6.5</span></div>
    </aside>
  </section>

  <section>
    <div class="sec-head">
      <span class="sec-no">01</span>
      <h2>教育背景<span class="sec-en">Education</span></h2>
    </div>
    <div class="edu">
      <p class="edu-line"><strong>法学</strong><span class="edu-note">主修课程：法理学、民法总论、刑法、刑事诉讼法、行政法与行政诉讼法、知识产权法、商法、民事诉讼法、国际公法</span></p>
      <p class="edu-line"><strong>经济学</strong><span class="edu-note">主修课程：高等数学、政治经济学、数理统计与概率论、中级微观经济学、中级宏观经济学、中级计量经济学</span></p>
    </div>
  </section>

  <section>
    <div class="sec-head">
      <span class="sec-no">02</span>
      <h2>实习经历<span class="sec-en">Internships</span></h2>
    </div>
    <article class="entry">
      <header class="entry-head">
        <span class="e-date mono">2025.07 - 2025.08</span>
        <h3>广东智洋凯成律师事务所</h3>
        <span class="role">律师助理</span>
      </header>
      <ul>
        <li>协助民事案件处理：证据整理标注、独立推进网上立案，参与建设工程纠纷专项并完成类案检索报告</li>
        <li>研读刑事案件卷宗，独立撰写法律文书；跟进合同诈骗上诉案，整合证据链并撰写上诉材料</li>
        <li>为顾问单位审查文件、修订管理办法并提出合规建议；审查交通领域协议，回复国企合规咨询</li>
      </ul>
    </article>
    <article class="entry">
      <header class="entry-head">
        <span class="e-date mono">2024.07 - 2024.08</span>
        <h3>广东中南钢铁股份有限公司</h3>
        <span class="role">法务与合规部门实习生</span>
      </header>
      <ul>
        <li>协助处理买卖合同纠纷案：证据材料整理、法律条文核对及案件时间轴可视化梳理</li>
        <li>完成《限制出境措施解除条件案例检索报告》，独立检索相关裁判文书</li>
        <li>参与部门合规培训项目与会议</li>
      </ul>
    </article>
    <article class="entry">
      <header class="entry-head">
        <span class="e-date mono">2024.01 - 2024.02</span>
        <h3>韶关市曲江区人民法院</h3>
        <span class="role">法官助理实习生</span>
      </header>
      <ul>
        <li>系统学习案件全流程管理：立案审查、庭审记录、文书送达及执行程序等核心环节</li>
        <li>协助法官完成判决书、调解书等法律文书初稿起草及校对，累计处理案件文书 20+ 份</li>
        <li>参与民商事案件研讨，独立完成法律检索报告，分析争议焦点并提出裁判依据建议</li>
        <li>全程观摩多场庭审并记录，深化对诉讼程序、证据规则及法庭辩论技巧的理解</li>
      </ul>
    </article>
  </section>

  <section>
    <div class="sec-head">
      <span class="sec-no">03</span>
      <h2>项目经历<span class="sec-en">Research</span></h2>
    </div>
    <article class="entry">
      <header class="entry-head">
        <span class="e-date mono">2024.07 - 2025.01</span>
        <h3>人工智能边境安全情报态势感知模型研究（省级大创立项）</h3>
        <span class="role">校际研究员</span>
      </header>
      <ul>
        <li>聚焦 AI 法律伦理议题，结合边境安全与跨境数据场景，系统梳理《数据安全法》中算法决策合规、跨境数据流动、隐私保护等核心法规依据</li>
        <li>支撑项目伦理合规模块研究，辅助团队规避 AI 技术应用的合规风险</li>
        <li>参与校际法律伦理研讨会，提出算法透明化、风险分级管控的实操建议</li>
      </ul>
    </article>
    <article class="entry">
      <header class="entry-head">
        <span class="e-date mono">2024.06 - 2024.09</span>
        <h3>双减背景下大学生家教市场的利益分配与权益保障实证分析</h3>
        <span class="role">项目组长</span>
      </header>
      <ul>
        <li>设计问卷调查并对当事人访谈，收集大学生家教市场的一手数据</li>
        <li>运用中间利润分配模型剖析利益分配机制，提出优化教师、家长、平台间利益关系的具体建议</li>
        <li>针对家教过程中的权益侵害问题，提出合同签订、中介费用规范等权益保障措施</li>
      </ul>
    </article>
  </section>

  <section>
    <div class="sec-head">
      <span class="sec-no">04</span>
      <h2>在校经历<span class="sec-en">Campus</span></h2>
    </div>
    <article class="entry">
      <header class="entry-head">
        <span class="e-date mono">2023.11 - 2024.11</span>
        <h3>中南财经政法大学未来律师协会</h3>
        <span class="role">外联部干事</span>
      </header>
      <ul>
        <li>第二届「江城杯」模拟法庭外联部负责人：对接北京盈科（武汉）律师事务所并邀请实务专家参与文书评审，多渠道宣传吸引武汉大学、华中科技大学等 8 所高校参赛，并协调多所高校的赛事对接</li>
        <li>第三届盈之楚辩论赛外联统筹负责人：洽谈企业赞助，成功获得赞助经费，实现赛事经费自给</li>
      </ul>
    </article>
  </section>

  <section>
    <div class="sec-head">
      <span class="sec-no">05</span>
      <h2>技能与证书<span class="sec-en">Skills</span></h2>
    </div>
    {/* 技能写具体事实，不做「精通/高级」自评分级：分级无信息量且是面试第一个被挑战的点 */}
    <div class="skills">
      <div class="skill-row"><span class="k">法律检索</span><span class="v">北大法宝、中国裁判文书网、Westlaw；课程论文《竞业限制的滥用与规制》引用熊晖、王瑞宏对 556 份裁判文书的统计等实证材料（见<a href="/notes/non-compete/">笔记栏</a>）</span></div>
      <div class="skill-row"><span class="k">工程</span><span class="v">Python、JavaScript/TypeScript、SQLite/FTS5、RAG 与评测管线、多 Agent 编排、Git/CI（全部有公开仓库背书，见<a href="/projects/">项目栏</a>）</span></div>
      <div class="skill-row"><span class="k">技能证书</span><span class="v">计算机二级（MS Office）、C1 驾驶证</span></div>
      <div class="skill-row"><span class="k">社媒活动</span><span class="v">小红书自媒体运营：浏览量累计 <strong class="mono">18 万+</strong>，获赞及收藏近 <strong class="mono">5000</strong></span></div>
      <div class="skill-row"><span class="k">兴趣爱好</span><span class="v">羽毛球、骑行、健身</span></div>
    </div>
  </section>

  <section>
    <div class="sec-head">
      <span class="sec-no">06</span>
      <h2>联系我<span class="sec-en">Contact</span></h2>
    </div>
    <div class="contact">
      <p>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        {SITE.email && <> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></>}
        。此刻在做什么见 <a href="/now/">Now</a> 页。
      </p>
      {/* TODO(资产): 简历 PDF 补齐后恢复下载按钮（href=/resume/hu-shengwei-resume.pdf），并移除 check-links 白名单 */}
      <p>简历可<a href={`mailto:${SITE.email}?subject=${encodeURIComponent('简历索取')}`}>来信索取</a>。</p>
    </div>
  </section>
</BaseLayout>
<style>
  /* ---- 头部：左简介 + 右事实面板（与首页数字面板同语言） ---- */
  .about-hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; padding: 3.5rem 0 0; align-items: start; }
  h1 { margin: 0 0 1.2rem; }
  .intro p { color: var(--text-muted); max-width: 40rem; }
  .facts { background: var(--surface); border: 1.5px solid var(--border-strong); padding: 1.2rem 1.6rem; }
  .fact-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--border); }
  .fact-row:last-child { border-bottom: none; }
  .fact-row .k { font-size: 0.85rem; color: var(--text-muted); flex: none; }
  .fact-row .v { font-weight: 600; font-size: 0.95rem; text-align: right; }
  .facts .mono { font-size: 0.9rem; }

  section { margin: 3.5rem 0; }

  /* ---- 经历条目：等宽日期 + 机构 + 职位，蓝方块列表 ---- */
  .entry { padding: 1.4rem 0 1.5rem; border-top: 1px solid var(--border); }
  .entry-head { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .e-date { font-size: 0.82rem; color: var(--text-muted); flex: none; }
  /* 页内小标题与加粗统一 700：Noto Sans SC 无 800 面，显式 800 会回落 900，与全站 h2/h3 口径不一致 */
  .entry h3 { font-size: 1.12rem; font-weight: 700; }
  .entry .role { font-size: 0.88rem; color: var(--text-muted); }
  .entry .role::before { content: '· '; color: var(--text-muted); }
  .entry ul { list-style: none; margin: 0.7rem 0 0; padding: 0; }
  .entry li { position: relative; padding: 0.18rem 0 0.18rem 1.05rem; color: var(--text); font-size: 0.95rem; }
  .entry li::before { content: ''; position: absolute; left: 0; top: 0.72em; width: 6px; height: 6px; background: var(--accent); }

  /* ---- 教育背景：两条课程行 ---- */
  .edu { padding-top: 1.2rem; }
  .edu-line { margin: 0 0 0.9rem; font-size: 0.95rem; }
  .edu-line strong { font-size: 1.05rem; font-weight: 700; margin-right: 1rem; }
  .edu-note { color: var(--text-muted); }

  /* ---- 技能：k/v 行式清单 ---- */
  .skills { padding-top: 1.2rem; }
  .skill-row { display: grid; grid-template-columns: 7rem 1fr; gap: 1.2rem; padding: 0.75rem 0; border-top: 1px solid var(--border); font-size: 0.95rem; }
  .skill-row:first-child { border-top: none; }
  .skill-row .k { color: var(--text-muted); font-weight: 600; font-size: 0.88rem; }
  .skill-row .v { color: var(--text); }
  .skills .mono { font-size: 0.92rem; }

  .contact p { margin: 0.4rem 0; }
  .contact { padding-top: 1.2rem; }

  @media (max-width: 900px) {
    .about-hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 2.5rem; }
    .skill-row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
