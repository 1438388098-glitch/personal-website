---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../lib/site';
import { EXAM_AGG } from '../lib/exam-progress';
import { byDateDesc } from '../lib/sort';
import { isPublished } from '../lib/publish';

const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const posts = (await getCollection('posts', isPublished))
  .sort(byDateDesc((p) => p.data.pubDate, (p) => p.id))
  .slice(0, 4);
// Now 摘要：最新一期 + frontmatter topics（结构化字段，正文不再承担取数职责）
const currentNow = (await getCollection('now'))
  .sort((a, b) => b.data.period.localeCompare(a.data.period))[0];
const nowTopics = currentNow?.data.topics ?? [];
// 数字面板：取自精选项目 frontmatter 的 metrics（单一事实源在内容文件，此处只做展示挑选）
// 标签用精确匹配而非前缀：前缀匹配在标签被改写后会静默取到空串（首页曾有一行指标渲染为空，
// 正是「Recall@5」被改写成「盲写留出题 Recall@5」后前缀对不上）。改名即取不到，由 check:dist 拦下。
const metricOf = (id: string, label: string) =>
  featuredProjects.find((p) => p.id === id)?.data.metrics.find((m) => m.label === label)?.value ?? '';
const panelRows = [
  { k: '法条检索 Recall@5', v: metricOf('statute-rag', '盲写留出题 Recall@5') },
  { k: '入库法条', v: metricOf('statute-rag', '语料规模') },
  { k: '评测规模 · 法衡', v: metricOf('cn-judbench', '评测规模') },
  { k: '判分口径 · 逐采分点', v: metricOf('fakao-grader', '判定口径') },
];
---
<BaseLayout title={SITE.title}>
  <section class="hero">
    <div>
      <p class="label fade-up">法律 × 工程<span class="sec-en">Law × Engineering</span></p>
      <h1 class="fade-up d1">法学在读，<br />业余<span class="hl">造工具</span>。</h1>
      <p class="lede fade-up d2">法条检索、法考判分、司法评测，全部开源，数字可查。</p>
      <div class="pills fade-up d2">
        <span class="pill">备考法考中</span>
        <span class="pill alt">武汉</span>
        <span class="pill">全部开源</span>
      </div>
      <p class="ctas fade-up d3">
        <a class="btn primary" href="/projects/">看项目 <span class="arr" aria-hidden="true">→</span></a>
        <a class="link-plain" href="/about/">关于我</a>
        <a class="link-plain" href={`mailto:${SITE.email}`}>联系我</a>
      </p>
    </div>
    <aside class="numbers fade-up d2" aria-label="关键数字">
      <div class="comp" aria-hidden="true">
        <i class="c1"></i><i class="c2"></i><i class="c3"></i><i class="c4"></i>
      </div>
      <div class="num-list">
        {panelRows.map((row) => (
          <div class="num-row"><span class="k">{row.k}</span><span class="v mono">{row.v}</span></div>
        ))}
      </div>
    </aside>
  </section>

  {featuredProjects.length > 0 && (
    <section data-reveal>
      <div class="sec-head">
        <span class="sec-no">01</span>
        <h2>精选项目<span class="sec-en">Selected Work</span></h2>
        <a href="/projects/">全部项目 →</a>
      </div>
      <div class="featured-grid">
        {featuredProjects.map((p, i) => (
          <div class:list={['cell', { wide: i === 0 }]}><ProjectCard project={p} showMetrics={false} index={i + 1} /></div>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section data-reveal>
      <div class="sec-head">
        <span class="sec-no">02</span>
        <h2>最近写作<span class="sec-en">Writing</span></h2>
        <a href="/blog/">全部文章 →</a>
      </div>
      {posts.map((p) => <PostCard post={p} />)}
    </section>
  )}

  <section data-reveal>
    <div class="sec-head">
      <span class="sec-no">03</span>
      <h2>接着逛<span class="sec-en">Explore</span></h2>
    </div>
    <div class="featured-grid">
      <article class="card explore-card">
        <h3><a href="/notes/">笔记</a></h3>
        <p>课程论文与文献研读</p>
      </article>
      <article class="card explore-card">
        <h3><a href="/toolbox/">工具箱</a></h3>
        <p>公开在 GitHub 的法律工具，一键到仓库</p>
      </article>
    </div>
  </section>

  <section class="band" aria-label="近期动态" data-reveal>
    <div class="band-inner">
      <div>
        <p class="label">法考 × AI<span class="sec-en">Exam Workflow</span></p>
        <h2>把 AI 缝进备考流程</h2>
        <p class="band-text">错题变笔记、主观题机器初判、法条检索必带引用，每个环节一个自建工具。</p>
        <p class="band-figures mono">{EXAM_AGG.subjects} 科目 / {EXAM_AGG.wrongQuestions} 错题</p>
      </div>
      <a class="btn band-btn" href="/exam/">看备考工作流 <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>

  {currentNow && (
    <section class="now-strip" data-reveal>
      <div class="sec-head">
        <span class="sec-no">04</span>
        <h2>Now<span class="sec-en">{currentNow.data.period}</span></h2>
        <a href="/now/">看本期动态 →</a>
      </div>
      <div class="now-chips">
        {nowTopics.map((t) => <span class="pill">{t}</span>)}
      </div>
    </section>
  )}
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    description: SITE.description,
    url: SITE.url,
    author: { '@type': 'Person', name: SITE.author, jobTitle: '法学在读 · 法律 × AI', url: SITE.github }
  })} />
</BaseLayout>
<style>
  /* ---- 首屏：纸面网格 / 网格线 / 文案 / 数字面板 四层，从后往前压 ----
     底纹原本直接挂在 .hero 上并带 mask，遮罩会连子内容一起淡化：主按钮实测 alpha 0.595，
     #17160f 被兑成 #737373。现在底纹下沉到 ::before，遮罩只作用于点阵本身。 */
  .hero {
    position: relative;
    display: grid; grid-template-columns: 1.12fr 1fr; gap: 3.5rem;
    padding: 4.5rem 0; align-items: start;
  }
  /* 底纹层：主格 112px / 次格 28px 两级点阵，向下渐隐到块底，像一张收边的图纸 */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      radial-gradient(color-mix(in srgb, var(--ink) 22%, transparent) 1px, transparent 1px),
      radial-gradient(color-mix(in srgb, var(--ink) 10%, transparent) 1px, transparent 1px);
    background-size: 112px 112px, 28px 28px;
    background-position: center top, center top;
    -webkit-mask-image: linear-gradient(#000 55%, transparent);
            mask-image: linear-gradient(#000 55%, transparent);
  }
  /* 结构层：两栏分界的通高竖线（落在这两栏真正的栏界线上，不是空隙中腰，否则读起来像面板的左边框），
     首屏因此被切成两块板，内容不再是浮在空处 */
  .hero::after {
    content: ''; position: absolute; z-index: 0; pointer-events: none;
    top: 0; bottom: 0;
    left: calc((100% - 3.5rem) * (1.12 / 2.12));
    width: 1px; background: var(--border);
  }
  .hero > * { position: relative; z-index: 1; }
  .label { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.86rem; font-weight: 700; margin: 0 0 1.3rem; }
  .label::before { content: ''; width: 8px; height: 8px; background: var(--accent); flex: none; }
  .hero .hl { box-shadow: inset 0 -0.32em color-mix(in srgb, var(--accent) 26%, transparent); }
  .lede { margin: 1.3rem 0 0; max-width: 30rem; color: var(--text-muted); font-size: 1.06rem; }
  .pills { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1.5rem 0 0; padding: 0; }
  .pill {
    display: inline-flex; align-items: center; gap: 0.45rem;
    background: var(--surface); border: 1px solid var(--border);
    padding: 0.34rem 0.9rem; font-size: 0.88rem; font-weight: 500; color: var(--text);
  }
  .pill::before { content: ''; width: 7px; height: 7px; background: var(--ink); flex: none; }
  .pill.alt::before { background: var(--accent); }
  .ctas { display: flex; gap: 0.9rem; margin: 2.1rem 0 0; align-items: center; }
  .btn .arr { font-family: var(--font-mono); transition: transform 0.2s ease; }
  .btn:hover .arr { transform: translateX(4px); }
  /* 下划线加粗也要过渡：0.15s 与其余小图形的 hover 节奏一致，否则是硬闪 */
  .link-plain { font-size: 0.95rem; font-weight: 600; color: var(--text); box-shadow: inset 0 -1.5px var(--accent); padding-bottom: 1px; transition: box-shadow 0.15s ease; }
  .link-plain:hover { color: var(--text); box-shadow: inset 0 -2.5px var(--accent); text-decoration: none; }

  /* 数字面板：白底描边盒，几何构成（呼应设计参考的黑块构成）+ 等宽指标行。
     两层：右下错开 12px 的描边板垫在下面，底纹从板中间透出来，面板就落在纸叠上；
     左上角一枚蓝方块压在网格线顶端，与导语的方块同一记号。 */
  .numbers { background: var(--surface); border: 1.5px solid var(--border-strong); }
  .numbers::after {
    content: ''; position: absolute; z-index: -1; pointer-events: none;
    inset: 12px -12px -12px 12px;
    border: 1px solid var(--border);
  }
  /* 竖线顶端的蓝方块：与导语那枚 8px 方块同一记号，压在栏界线上（3.5rem + 自身半宽） */
  .numbers::before {
    content: ''; position: absolute; left: calc(-3.5rem - 4px); top: 0;
    width: 8px; height: 8px; background: var(--accent);
  }
  .comp { display: flex; align-items: flex-end; gap: 10px; padding: 1.6rem 1.8rem 0; height: 180px; }
  .comp i { display: block; border: 1.5px solid var(--ink); }
  .comp .c1 { width: 96px; height: 150px; }
  .comp .c2 { width: 44px; height: 96px; }
  .comp .c3 { width: 44px; height: 64px; }
  .comp .c4 { width: 96px; height: 108px; background: var(--ink); position: relative; }
  .comp .c4::after { content: ''; position: absolute; right: 10px; top: 10px; width: 12px; height: 12px; background: var(--accent); }
  .num-list { padding: 0.4rem 1.8rem 1.2rem; }
  .num-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--border); }
  .num-row:last-child { border-bottom: none; }
  .num-row .k { font-size: 0.9rem; color: var(--text-muted); }
  .num-row .v { font-size: 1.15rem; font-weight: 700; white-space: nowrap; color: var(--text); }

  section { margin: 4.5rem 0; }
  section.band { margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); }
  .featured-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.2rem; }
  .cell.wide { grid-column: 1 / -1; }
  /* 栏目入口卡：复用 .card 直角白面与工具箱页的「标题链接」语言，只补内边距与字号 */
  .explore-card { padding: 1.2rem 1.4rem; }
  .explore-card h3 { margin: 0 0 0.4rem; font-size: 1.15rem; }
  .explore-card h3 a { color: var(--text); }
  .explore-card h3 a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--accent); }
  .explore-card p { margin: 0; color: var(--text-muted); font-size: 0.95rem; }
  /* 首位精选项目升级为大卡：更宽的呼吸、更大的标题与摘要 */
  .cell.wide :global(.project-card) { padding: 1.7rem 1.9rem; }
  .cell.wide :global(.project-card h3) { font-size: 1.45rem; }
  .cell.wide :global(.project-card .summary) { font-size: 1.02rem; max-width: 58ch; }

  /* 法考 × AI 通栏反色块：全页最重的高对比色块，两角 + 记号呼应图纸底纹。
     颜色全走 --band-* 令牌（见 global.css）：亮色墨底反白，暗色不是降级成浅灰面板，
     而是换成比页底更深一层的实色，区块重量与两角的 accent 记号都留着。 */
  .band { background: var(--band-bg); color: var(--band-fg); position: relative; border-block: 1px solid var(--band-line); }
  .band::before, .band::after {
    content: '+'; position: absolute; font-family: var(--font-mono);
    font-size: 1.1rem; color: var(--band-mark); top: 8px;
  }
  .band::before { left: 12px; }
  .band::after { right: 12px; }
  .band-inner { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; padding: 2.8rem 1.25rem; max-width: var(--maxw); margin-inline: auto; }
  .band .label { color: var(--band-fg); margin: 0; }
  .band .sec-en { color: inherit; opacity: 0.55; }
  .band h2 { margin: 0.6rem 0 0; }
  .band-text { margin: 0.6rem 0 0; opacity: 0.75; max-width: 44rem; font-size: 1rem; }
  .band-figures { margin: 0.8rem 0 0; font-size: 0.95rem; opacity: 0.9; }
  .band .band-btn { border-color: var(--band-fg); color: var(--band-fg); background: none; }
  .band .band-btn:hover { background: var(--band-fg); color: var(--band-bg); }

  .now-chips { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.2rem; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 2.4rem; padding: 3rem 0; }
    /* 单栏后两栏之间那条竖线没有意义，连同压在它顶端的蓝方块一起收起 */
    .hero::after, .numbers::before { display: none; }
    .featured-grid { grid-template-columns: 1fr; }
    .band-inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .hero { padding: 2.5rem 0; }
  }
  /* 窄屏：几何构成缩比，避免固定尺寸撑破数字面板（曾溢出 ~20px 被裁掉右边框） */
  @media (max-width: 480px) {
    .comp { height: 140px; }
    .comp .c1 { width: 72px; height: 112px; }
    .comp .c2 { width: 34px; height: 72px; }
    .comp .c3 { width: 34px; height: 48px; }
    .comp .c4 { width: 72px; height: 80px; }
    .num-list { padding-inline: 1.2rem; }
  }
</style>
