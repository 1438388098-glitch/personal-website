---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricStrip from '../components/MetricStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../lib/site';
import { EXAM_AGG } from '../lib/exam-progress';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
// Now 摘要：最新一期 + 正文前两个 H2 标题（直接从 markdown 原文按行提取，无需渲染）
const currentNow = (await getCollection('now'))
  .sort((a, b) => b.data.period.localeCompare(a.data.period))[0];
const nowTopics = (currentNow?.body ?? '')
  .split('\n')
  .filter((line) => line.startsWith('## '))
  .slice(0, 2)
  .map((line) => line.replace(/^##\s*/, '').trim());
---
<BaseLayout title={SITE.title}>
  <section class="hero">
    <h1 class="fade-up">{SITE.author}</h1>
    <p class="tagline fade-up d1">法学在读，业余造工具。法条检索、法考判分、司法评测，全部开源，数字可查。</p>
    <p class="status fade-up d2">备考法考中 · 武汉</p>
    <p class="ctas fade-up d3">
      <a class="btn primary" href="/projects/">看项目</a>
      <a class="btn" href="/about/">关于我</a>
    </p>
  </section>

  <div data-reveal><MetricStrip /></div>

  {projects.length > 0 && (
    <section data-reveal>
      <div class="section-head"><h2>精选项目</h2><a href="/projects/">全部项目</a></div>
      <div class="featured-grid">
        {projects.map((p, i) => (
          <div class:list={['cell', { wide: i === 0 }]}><ProjectCard project={p} /></div>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section data-reveal>
      <div class="section-head"><h2>最近写作</h2><a href="/blog/">全部文章</a></div>
      {posts.map((p) => <PostCard post={p} />)}
    </section>
  )}

  <section aria-label="近期动态" data-reveal>
    <div class="dynamic-grid">
      <div class="dyn-card">
        <h2><a href="/exam/">法考 × AI</a></h2>
        <p class="dyn-text">把 AI 深深缝进备考流程：错题变笔记、主观题机器初判、法条检索必带引用，每个环节一个自建工具。</p>
        <p class="dyn-figures">{EXAM_AGG.subjects} 科目 / {EXAM_AGG.wrongQuestions} 错题</p>
        <a class="dyn-link" href="/exam/">看备考工作流</a>
      </div>
      {currentNow && (
        <div class="dyn-card">
          <h2><a href="/now/">Now · {currentNow.data.period}</a></h2>
          <ul class="dyn-list">
            {nowTopics.map((t) => <li>{t}</li>)}
          </ul>
          <a class="dyn-link" href="/now/">看本期动态</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 4.25rem 0 3rem; }
  .hero h1 { margin: 0 0 1rem; font-size: clamp(2.8rem, 6vw, 4.2rem); font-weight: 800; letter-spacing: -0.02em; }
  .tagline { font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.75; margin: 0 0 0.9rem; max-width: 34rem; text-wrap: balance; }
  .status { color: var(--text-muted); margin: 0 0 1.5rem; font-size: 0.95rem; }
  .ctas { display: flex; gap: 0.75rem; margin: 0; }
  .btn {
    border: 1px solid var(--border); border-radius: 8px; padding: 0.5rem 1.2rem; color: var(--text);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease, filter 0.2s ease;
  }
  .btn:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; transform: translateY(-1px); }
  .btn:active { transform: translateY(1px); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.primary:hover { filter: brightness(1.08); color: #fff; }
  /* a11y：暗色下朱砂底(#d4694f)配白字对比度约 3.5:1 不达标，改深字 ≈5.2:1 */
  :global(html[data-theme='dark']) .btn.primary { color: #20100c; }
  section { margin: 2.5rem 0; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.75rem; }
  .section-head h2 { margin: 0; }
  .featured-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .cell.wide { grid-column: 1 / -1; }
  @media (max-width: 720px) { .featured-grid { grid-template-columns: 1fr; } }
  /* 首页动态区：法考卡宽、Now 窄的不对称网格，低动效（仅链接 hover 下划线） */
  .dynamic-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; align-items: stretch; }
  .dyn-card { border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem 1.4rem; display: flex; flex-direction: column; gap: 0.45rem; margin: 0; background: var(--bg); transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1); }
  .dyn-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); box-shadow: 0 14px 30px -20px rgba(0, 0, 0, 0.35); }
  .dyn-card h2 { margin: 0; font-size: 1.15rem; }
  .dyn-card h2 a { color: var(--text); }
  .dyn-card h2 a:hover { color: var(--accent); text-decoration: none; }
  .dyn-text { color: var(--text-muted); margin: 0; }
  .dyn-figures { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .dyn-list { margin: 0; padding-left: 1.2rem; color: var(--text-muted); }
  .dyn-link { margin-top: auto; font-size: 0.9rem; }
  @media (max-width: 720px) { .dynamic-grid { grid-template-columns: 1fr; } }
</style>
