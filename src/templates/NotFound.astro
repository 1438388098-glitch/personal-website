---
/* 404 模板：zh（/404.html）与 en（/en/404.html）共用 */
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../lib/i18n';
import { strings, href } from '../lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = strings(lang);
---
<BaseLayout title={t.notFound.title} description={t.notFound.metaDescription} noindex alternate={null}>
  <section class="lost">
    <p class="code" aria-hidden="true">404</p>
    <h1>{t.notFound.h1}</h1>
    <p class="hint">{t.notFound.hint}</p>
    <p class="paths">
      <a class="btn primary" href={lang === 'en' ? '/en/' : '/'}>{t.notFound.home}</a>
      <a class="btn" href={href(lang, '/projects/')}>{t.notFound.projects}</a>
      <a class="btn" href={href(lang, '/blog/')}>{t.notFound.blog}</a>
      <a class="btn" href={href(lang, '/search/')}>{t.notFound.search}</a>
    </p>
  </section>
</BaseLayout>
<style>
  .lost { padding: 4rem 0 3.5rem; }
  .code {
    font-family: var(--font-mono); font-weight: 700; color: var(--accent);
    font-size: clamp(4.5rem, 12vw, 7rem); line-height: 1; letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  h1 { margin: 0 0 0.75rem; }
  .hint { color: var(--text-muted); margin: 0 0 1.5rem; }
  .paths { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 0; }
</style>
