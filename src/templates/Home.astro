---
/* 首页模板：zh（/）与 en（/en/）共用。文案全走字典；数字面板从精选项目 frontmatter 取数。
   en 版差异：无法考通栏（exam 不译）、探索区只有工具箱、hero 走 Archivo。 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import JsonLd from '../components/JsonLd.astro';
import type { Lang } from '../lib/i18n';
import { strings, href } from '../lib/i18n';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';
import { EXAM_AGG } from '../lib/exam-progress';
import { getPublishedPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = strings(lang);

const allProjects = await getProjects(lang);
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  /* order 并列时按 id 兜底，与 byDateDesc 同理：顺序不依赖内容层迭代 */
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))
  .slice(0, 4);
const posts = (await getPublishedPosts(lang)).slice(0, 4);
// Now 摘要：最新一期 + frontmatter topics（结构化字段，正文不再承担取数职责）
const nowEntry = (await getCollection(lang === 'en' ? 'nowEn' : 'now'))
  .sort((a, b) => b.data.period.localeCompare(a.data.period))[0];
const nowTopics = nowEntry?.data.topics ?? [];
// 数字面板：取自项目 frontmatter 的 metrics（单一事实源在内容文件，此处只做展示挑选）
// 取数范围是全量项目而非精选集：量化行来自 stock-db，若只查精选集该行会渲染为空。
// 标签用精确匹配而非前缀：前缀匹配在标签被改写后会静默取到空串（首页曾有一行指标渲染为空，
// 正是「Recall@5」被改写成「盲写留出题 Recall@5」后前缀对不上）。改名即取不到，由 check:dist 拦下。
const metricOf = (id: string, label: string) =>
  allProjects.find((p) => p.id === id)?.data.metrics.find((m) => m.label === label)?.value ?? '';
const panelRows = t.home.panel.map((row) => ({ ...row, v: metricOf(row.projectId, row.metricLabel) }));
---
<BaseLayout title={lang === 'en' ? SITE.titleEn : SITE.title} alternate={lang === 'zh' ? '/en/' : '/'}>
  <section class="hero">
    <div>
      <p class="label fade-up">{t.home.label}{lang === 'zh' && <span class="sec-en">Law × Engineering</span>}</p>
      <h1 class="fade-up d1" set:html={t.home.h1} />
      <p class="lede fade-up d2" set:html={t.home.lede} />
      <div class="pills fade-up d2">
        <p class="meta-line">{t.home.pills.join(' · ')}</p>
      </div>
      <p class="ctas fade-up d3">
        <a class="btn primary" href={href(lang, '/projects/')}>{t.home.ctas.primary} <span class="arr" aria-hidden="true">→</span></a>
        <a class="link-plain" href={href(lang, '/about/')}>{t.home.ctas.about}</a>
        <a class="link-plain" href={`mailto:${SITE.email}`}>{t.home.ctas.contact}</a>
      </p>
    </div>
    <aside class="numbers fade-up d2" aria-label={t.home.numbersAria}>
      <div class="num-list">
        {panelRows.map((row) => (
          <div class="num-row"><span class="k">{row.k}</span><span class="v mono">{row.v}</span></div>
        ))}
      </div>
    </aside>
  </section>

  {featuredProjects.length > 0 && (
    <section data-reveal>
      <div class="sec-head">
        <span class="sec-no">01</span>
        <h2>{t.home.featured.h2}{lang === 'zh' && <span class="sec-en">{t.home.featured.en}</span>}</h2>
        <a href={href(lang, '/projects/')}>{t.home.featured.link}</a>
      </div>
      <div class="work-grid">
        {featuredProjects.map((p, i) => (
          <div class:list={['cell', { wide: i === 0 }]}><ProjectCard project={p} showMetrics={false} index={i + 1} /></div>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section data-reveal>
      <div class="sec-head">
        <span class="sec-no">02</span>
        <h2>{t.home.writing.h2}{lang === 'zh' && <span class="sec-en">{t.home.writing.en}</span>}</h2>
        <a href={href(lang, '/blog/')}>{t.home.writing.link}</a>
      </div>
      {posts.map((p) => <PostCard post={p} />)}
    </section>
  )}

  <section data-reveal>
    <div class="sec-head">
      <span class="sec-no">03</span>
      <h2>{t.home.explore.h2}{lang === 'zh' && <span class="sec-en">{t.home.explore.en}</span>}</h2>
    </div>
    <div class="featured-grid">
      {t.home.exploreCards.map((c) => (
        <article class="card explore-card">
          <h3><a href={c.href.startsWith('/') ? href(lang, c.href) : c.href}>{c.title}</a></h3>
          <p>{c.desc}</p>
        </article>
      ))}
    </div>
  </section>

  {t.home.band && (
    <section class="band" aria-label={t.home.band.label} data-reveal>
      <div class="band-inner">
        <div>
          <p class="label">{t.home.band.label}<span class="sec-en">{t.home.band.en}</span></p>
          <h2>{t.home.band.h2}</h2>
          <p class="band-text">{t.home.band.text}</p>
          <p class="band-figures mono">{t.home.band.figures(EXAM_AGG.subjects, EXAM_AGG.wrongQuestions)}</p>
        </div>
        <a class="btn band-btn" href={href(lang, t.home.band.href)}>{t.home.band.btn} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  {nowEntry && (
    <section class="now-strip" data-reveal>
      <div class="sec-head">
        <span class="sec-no">04</span>
        <h2>Now{lang === 'zh' && <span class="sec-en">{nowEntry.data.period}</span>}</h2>
        <a href={href(lang, '/now/')}>{t.home.now.link}</a>
      </div>
      <div class="now-chips">
        {nowTopics.map((topic) => <span class="pill">{topic}</span>)}
      </div>
    </section>
  )}
  <JsonLd data={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t.home.title,
    description: lang === 'en' ? SITE.descriptionEn : SITE.description,
    url: SITE.url,
    author: { '@type': 'Person', name: t.authorName, jobTitle: t.home.jsonLdJobTitle, url: SITE.github },
    /* 站内搜索入口声明：让搜索引擎在站点结果里直接给出搜索框 */
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}${t.searchAction}?q={search_term_string}` },
      'query-input': 'required name=search_term_string'
    }
  }} />
</BaseLayout>
<style>
  /* ---- 首屏：纸面网格 / 网格线 / 文案 / 数字面板 四层，从后往前压 ----
     底纹原本直接挂在 .hero 上并带 mask，遮罩会连子内容一起淡化：主按钮实测 alpha 0.595，
     #17160f 被兑成 #737373。现在底纹下沉到 ::before，遮罩只作用于点阵本身。 */
  .hero {
    position: relative;
    display: grid; grid-template-columns: 1.12fr 1fr; gap: 3.5rem;
    padding: 4.5rem 0; align-items: start;
  }
  /* 底纹层：主格 112px / 次格 28px 两级点阵，向下渐隐到块底，像一张收边的图纸 */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      radial-gradient(color-mix(in srgb, var(--ink) 22%, transparent) 1px, transparent 1px),
      radial-gradient(color-mix(in srgb, var(--ink) 10%, transparent) 1px, transparent 1px);
    background-size: 112px 112px, 28px 28px;
    background-position: center top, center top;
    -webkit-mask-image: linear-gradient(#000 55%, transparent);
            mask-image: linear-gradient(#000 55%, transparent);
  }
  /* 结构层：两栏分界的通高竖线（落在这两栏真正的栏界线上，不是空隙中腰，否则读起来像面板的左边框），
     首屏因此被切成两块板，内容不再是浮在空处 */
  .hero::after {
    content: ''; position: absolute; z-index: 0; pointer-events: none;
    top: 0; bottom: 0;
    left: calc((100% - 3.5rem) * (1.12 / 2.12));
    width: 1px; background: var(--border);
  }
  .hero > * { position: relative; z-index: 1; }
  .label { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.86rem; font-weight: 700; margin: 0 0 1.3rem; }
  .label::before { content: ''; width: 8px; height: 8px; background: var(--accent); flex: none; }
  .hero .hl { box-shadow: inset 0 -0.32em color-mix(in srgb, var(--accent) 26%, transparent); }
  .lede { margin: 1.3rem 0 0; max-width: 34rem; color: var(--text-muted); font-size: 1.06rem; }
  /* hero 的元信息行：地点与状态作一行灰字注记（· 分隔），不再用三个边框小签——
     签盒与主按钮抢层级，其中「法律工具全部开源」与导语逐字重复。
     .pill 签样式保留给 Now 区话题行使用。 */
  .pills { margin: 1.15rem 0 0; padding: 0; }
  .meta-line { margin: 0; color: var(--text-muted); font-size: 0.92rem; letter-spacing: 0.01em; }
  .ctas { display: flex; gap: 0.9rem; margin: 1.9rem 0 0; align-items: center; }
  .btn .arr { font-family: var(--font-mono); transition: transform 0.2s ease; }
  .btn:hover .arr { transform: translateX(4px); }
  /* 下划线加粗也要过渡：0.15s 与其余小图形的 hover 节奏一致，否则是硬闪 */
  .link-plain { font-size: 0.95rem; font-weight: 600; color: var(--text); box-shadow: inset 0 -1.5px var(--accent); padding-bottom: 1px; transition: box-shadow 0.15s ease; }
  .link-plain:hover { color: var(--text); box-shadow: inset 0 -2.5px var(--accent); text-decoration: none; }

  /* 数字面板：白底描边盒 + 等宽指标行，只装真实数字。
     顶部原先有一块几何构成（三根描边柱加一块实心块），没有数据含义、比例也是随手定的；
     暗色下实心块随 --ink 翻成一整块奶油底，正是「暗色不做反白色块」那条教训的复现。
     右下错开 12px 的描边板同样去掉：1px 发丝在深色底上读起来像画歪的第二条边。
     现在面板只留一层描边盒，加上左上角那枚压在栏界线上的蓝方块（与导语方块同一记号）。 */
  .numbers { background: var(--surface); border: 1.5px solid var(--border-strong); }
  /* 竖线顶端的蓝方块：与导语那枚 8px 方块同一记号，压在栏界线上（3.5rem + 自身半宽） */
  .numbers::before {
    content: ''; position: absolute; left: calc(-3.5rem - 4px); top: 0;
    width: 8px; height: 8px; background: var(--accent);
  }
  /* 行距放宽一档：五行指标是一份清单，不是仪表盘；给数字留出呼吸 */
  .num-list { padding: 0.4rem 1.8rem 1.35rem; }
  .num-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1.05rem 0; border-bottom: 1px solid var(--border); }
  .num-row:last-child { border-bottom: none; }
  .num-row .k { font-size: 0.95rem; color: var(--text-muted); }
  /* 术语括注小字已整体删去：标签—数值两列清单不需要第二层说明；
     面板字号只剩 0.95 / 1.25rem 两档，首屏高度也随两行括注的移除收紧。 */
  .num-row .v { font-size: 1.25rem; font-weight: 700; white-space: nowrap; color: var(--text); }

  section { margin: var(--section-gap) 0; }
  section.band { margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); }
  /* 探索区：固定两列；精选区用 .work-grid（列数需求不同，两类网格不合并） */
  .featured-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.2rem; }
  /* 精选：桌面为一张通栏主卡 + 三张并列（3 列）。不与 .featured-grid 合并：
     探索区固定两列，两类网格的列数需求不同，共用一类会顾此失彼。 */
  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.2rem; }
  .work-grid .cell.wide { grid-column: 1 / -1; }
  /* 同排卡片等高：.cell 作为网格项会被拉伸，但卡片描边挂在内部 .project-card 上，
     它的高度按内容走，内容短的那张底边就会比同排缩进去一截。让 cell 做 flex 容器，
     卡片就能被撑满，四张卡的上下边落在同两条横线上。 */
  .work-grid .cell { display: flex; }
  .work-grid .cell > :global(.project-card) { flex: 1; }
  /* 标题预留两行：三张卡标题行数不同（stock-db 只有一行）时，摘要的起始行会错开 */
  .work-grid .cell:not(.wide) :global(.project-card h3) { min-height: 2lh; }
  /* 主卡横向内边距与同排卡片对齐，四张卡的正文左边缘才落在同一条竖线上；
     纵向仍留 1.7rem，主卡靠字号与留白保持分量，而不是靠缩进错位 */
  .work-grid .cell.wide :global(.project-card) { padding: 1.7rem 1.6rem; }
  .work-grid .cell.wide :global(.project-card h3) { font-size: 1.45rem; }
  .work-grid .cell.wide :global(.project-card .summary) { font-size: 1.02rem; max-width: 58ch; }
  /* 栏目入口卡：复用 .card 直角白面与工具箱页的「标题链接」语言，只补内边距与字号 */
  .explore-card { padding: 1.2rem 1.4rem; }
  .explore-card h3 { margin: 0 0 0.4rem; font-size: var(--fs-card-title); }
  .explore-card h3 a { color: var(--text); }
  .explore-card h3 a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--accent); }
  .explore-card p { margin: 0; color: var(--text-muted); font-size: 0.95rem; }
  /* 首位精选项目升级为大卡：更宽的呼吸、更大的标题与摘要 */
  .cell.wide :global(.project-card) { padding: 1.7rem 1.9rem; }
  .cell.wide :global(.project-card h3) { font-size: 1.45rem; }
  .cell.wide :global(.project-card .summary) { font-size: 1.02rem; max-width: 58ch; }

  /* 法考 × AI 通栏反色块：全页最重的高对比色块，两角 + 记号呼应图纸底纹。
     颜色全走 --band-* 令牌（见 global.css）：亮色墨底反白，暗色不是降级成浅灰面板，
     而是换成比页底更深一层的实色，区块重量与两角的 accent 记号都留着。 */
  .band { background: var(--band-bg); color: var(--band-fg); position: relative; border-block: 1px solid var(--band-line); }
  .band::before, .band::after {
    content: '+'; position: absolute; font-family: var(--font-mono);
    font-size: 1.1rem; color: var(--band-mark); top: 8px;
  }
  .band::before { left: 12px; }
  .band::after { right: 12px; }
  .band-inner { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; padding: 2.8rem 1.25rem; max-width: var(--maxw); margin-inline: auto; }
  .band .label { color: var(--band-fg); margin: 0; }
  .band .sec-en { color: inherit; opacity: 0.55; }
  .band h2 { margin: 0.6rem 0 0; }
  .band-text { margin: 0.6rem 0 0; opacity: 0.75; max-width: 44rem; font-size: 1rem; }
  .band-figures { margin: 0.8rem 0 0; font-size: 0.95rem; opacity: 0.9; }
  .band .band-btn { border-color: var(--band-fg); color: var(--band-fg); background: none; }
  .band .band-btn:hover { background: var(--band-fg); color: var(--band-bg); }

  .now-chips { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.2rem; }

  /* ≤1024：主卡让位成等宽卡，四张排成 2×2。三列在 900~1024 区间会把摘要挤到五行以上、
     标题折两行，读起来费劲；四张等宽两列反而更整齐，也不留空位。 */
  @media (max-width: 1024px) {
    .work-grid { grid-template-columns: 1fr 1fr; }
    .work-grid .cell.wide { grid-column: auto; }
    .work-grid .cell.wide :global(.project-card) { padding: 1.4rem 1.6rem; }
    .work-grid .cell.wide :global(.project-card h3) { font-size: 1.22rem; }
    .work-grid .cell.wide :global(.project-card .summary) { font-size: inherit; max-width: none; }
  }
  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; gap: 2.4rem; padding: 3rem 0; }
    /* 单栏后两栏之间那条竖线没有意义，连同压在它顶端的蓝方块一起收起 */
    .hero::after, .numbers::before { display: none; }
    .featured-grid { grid-template-columns: 1fr; }
    .band-inner { grid-template-columns: 1fr; }
  }
  /* ≤720：单列，四张依次往下 */
  @media (max-width: 720px) {
    .hero { padding: 2.5rem 0; }
    .work-grid { grid-template-columns: 1fr; }
  }
  /* 窄屏：面板左右内边距收窄，避免「1,674 万行」这类长值与标签挤到贴边 */
  @media (max-width: 480px) {
    .num-list { padding-inline: 1.2rem; }
  }
</style>
