---
/* Now 页模板：单页只渲染最新一期，月更后由新条目自然替换（历史期不上站）。 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../lib/i18n';
import { strings, href } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = strings(lang);
const current = (await getCollection(lang === 'en' ? 'nowEn' : 'now'))
  .sort((a, b) => b.data.period.localeCompare(a.data.period))[0];
if (!current) throw new Error('now 集合为空：src/content/now/ 需至少保留一期 .md');
const { Content } = await render(current);
const period = current.data.period;
---
<BaseLayout title={`Now · ${period}`} description={t.now.metaDescription} type="article" publishedTime={current.data.updated} alternate={href(lang === 'zh' ? 'en' : 'zh', '/now/')}>
  <article class="prose">
    <p class="meta">{t.now.updatedPrefix}<span class="mono">{formatDate(current.data.updated, lang)}</span></p>
    <h1>Now · {period}</h1>
    <Content />
    <p class="see-also" set:html={t.now.seeAlsoHtml} />
  </article>
</BaseLayout>
<style>
  .meta { color: var(--text-muted); }
  .see-also { color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 1rem; }
</style>
