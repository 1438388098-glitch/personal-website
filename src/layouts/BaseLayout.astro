---
import { langOf, strings } from '../lib/i18n';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  image?: string;
  publishedTime?: Date;
  /** 对方语言的真实对应页（模板已核实存在）；缺省时切换器回退对方首页，且不发 hreflang */
  alternate?: string | null;
}
const { title, description, type, noindex, image, publishedTime, alternate = null } = Astro.props;
/* 语言只从 URL 判：zh 留根、en 走 /en/，模板不重复传 lang */
const lang = langOf(Astro.url.pathname);
const t = strings(lang);
/* 切换器落点：有真实对应页就切过去，没有就退回对方首页（宁可落到语言首页，不给死链） */
const switchHref = alternate ?? (lang === 'zh' ? '/en/' : '/');
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BaseHead
      title={title}
      description={description}
      type={type}
      noindex={noindex}
      image={image}
      publishedTime={publishedTime}
      alternate={alternate}
    />
    {/* 移动端图标与 PWA 清单：BaseHead 之外补这两条，避免与字体/favicon 逻辑混在一起 */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <Header switchHref={switchHref} />
    <main id="main" tabindex="-1" class="container">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      /* 滚动淡入：IntersectionObserver（不用 scroll 监听），进入视口即播放一次并停止观察 */
      (function () {
        document.documentElement.classList.add('fx');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        function scan() {
          document.querySelectorAll('[data-reveal]:not(.revealed)').forEach(function (el) {
            io.observe(el);
          });
        }
        scan();
        /* 换页会替换 <html>，fx 类须与主题一样在 after-swap 重放，否则首屏之后动画全站失效 */
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.add('fx');
          scan();
        });
      })();
    </script>
  </body>
</html>
