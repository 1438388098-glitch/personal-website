---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title: string; description?: string; type?: 'website' | 'article'; noindex?: boolean; image?: string; publishedTime?: Date; }
const { title, description, type, noindex, image, publishedTime } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BaseHead title={title} description={description} type={type} noindex={noindex} image={image} publishedTime={publishedTime} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main" tabindex="-1" class="container">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      /* 滚动淡入：IntersectionObserver（不用 scroll 监听），进入视口即播放一次并停止观察 */
      (function () {
        document.documentElement.classList.add('fx');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        function scan() {
          document.querySelectorAll('[data-reveal]:not(.revealed)').forEach(function (el) {
            io.observe(el);
          });
        }
        scan();
        /* 换页会替换 <html>，fx 类须与主题一样在 after-swap 重放，否则首屏之后动画全站失效 */
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.add('fx');
          scan();
        });
      })();
    </script>
  </body>
</html>
