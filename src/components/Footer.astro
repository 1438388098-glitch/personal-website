---
import { SITE } from '../lib/site';
const socials = [
  { label: 'GitHub', href: SITE.github },
  ...(SITE.zhihu ? [{ label: '知乎', href: SITE.zhihu }] : []),
  ...(SITE.email ? [{ label: 'Email', href: `mailto:${SITE.email}` }] : [])
];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p><span class="mark" aria-hidden="true"></span>© {year} {SITE.author} · <a href={SITE.poems} target="_blank" rel="noopener noreferrer">诗集《陌生的你》</a> · <a href="/feed.xml">RSS</a> · <a href="/search/">搜索</a> · <a href="/tags/">标签索引</a></p>
    <p class="socials">{socials.map((s) => s.href.startsWith('mailto:')
      ? <a href={s.href} rel="noopener noreferrer">{s.label}</a>
      : <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}</p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--border); margin-top: 4rem; padding: 2rem 0 3rem; color: var(--text-muted); font-size: 0.9rem; }
  .footer-inner { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; justify-content: space-between; }
  .footer-inner p { margin: 0; }
  /* 品牌小方块：与页头 brand-mark 呼应（无内芯的纯强调蓝） */
  .mark { display: inline-block; width: 10px; height: 10px; background: var(--accent); margin-right: 0.45rem; }
  /* a11y：链接不能仅靠颜色区分，页脚全部链接统一加下划线 */
  .site-footer a { text-decoration: underline; text-underline-offset: 3px; }
  .socials { display: flex; gap: 1rem; }
</style>
