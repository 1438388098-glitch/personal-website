---
/* 长文右侧目录：详情页正文右侧常年空着 526px，把这块空位交给节导航。
   标题直接取 render() 返回的 headings，与 astro.config 构建期注入的 § 锚链共用同一批 id。 */
import { langOf, strings } from '../lib/i18n';
interface Props { headings: { depth: number; slug: string; text: string }[]; }
const { headings } = Astro.props;
/* 只列二级标题：带上三级会变成第二份正文，反而找不到位置；两节以下不值得占一栏 */
const items = headings.filter((h) => h.depth === 2);
const t = strings(langOf(Astro.url.pathname));
---
{items.length >= 2 && (
  <nav class="toc" aria-label={t.tocAria}>
    <p class="toc-title" lang="en">On this page</p>
    <ul>
      {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ul>
  </nav>
)}
<script>
  /* 滚动高亮：取「最后一个越过判定线的标题」。
     为什么不用 IntersectionObserver 的进出事件（原实现）：最后一节滚到页面底部时再也不会「进入」
     观察带，事件判定会永远停在倒数第二节。实测点「制度建议」高亮落在「案例与数据」。
     位置判定永远有确定答案，且滚到页底时直接兜到最后一节。
     与博客页 tabs 同理挂在 astro:page-load；监听挂在 window 上，ClientRouter 换页不会随 DOM 一起消失，
     所以每次换页前必须自己摘掉上一份。 */
  type TocCleanup = () => void;
  const w = window as Window & { __tocCleanup?: TocCleanup };
  document.addEventListener('astro:page-load', () => {
    w.__tocCleanup?.();
    const toc = document.querySelector('.toc');
    if (!toc) return;
    const pairs = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a'))
      .map((a) => ({ a, li: a.parentElement, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
      .filter((p): p is { a: HTMLAnchorElement; li: HTMLElement | null; el: HTMLElement } => p.el !== null);
    if (pairs.length === 0) return;
    /* 判定线压在 sticky 页头下方一点，与标题的 scroll-margin-top 对齐 */
    const line = (document.querySelector('.site-header')?.getBoundingClientRect().height ?? 64) + 40;
    let raf = 0;
    let last = -1;
    const pick = () => {
      raf = 0;
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let idx = atBottom ? pairs.length - 1 : 0;
      if (!atBottom) {
        for (let i = 0; i < pairs.length; i++) {
          if (pairs[i].el.getBoundingClientRect().top <= line) idx = i;
        }
      }
      if (idx === last) return;
      last = idx;
      pairs.forEach((p, i) => {
        p.li?.classList.toggle('on', i === idx);
        /* 当前节同时报给读屏：高亮只有视觉，aria-current 是等价的语义 */
        if (i === idx) p.a.setAttribute('aria-current', 'true');
        else p.a.removeAttribute('aria-current');
      });
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(pick); };
    pick();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    w.__tocCleanup = () => {
      removeEventListener('scroll', onScroll);
      removeEventListener('resize', onScroll);
      if (raf) cancelAnimationFrame(raf);
      w.__tocCleanup = undefined;
    };
  });
</script>
<style>
  .toc {
    position: sticky; top: 5.5rem; max-height: calc(100vh - 8rem); overflow-y: auto;
    font-size: 0.86rem;
  }
  /* 栏头沿用 .sec-en 的英文对照样式，下面压 2px 墨线，与全站区块头同语言 */
  .toc-title {
    margin: 0 0 0.7rem; padding-bottom: 0.5rem;
    font-size: 0.66rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-muted); border-bottom: 2px solid var(--border-strong);
  }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  /* 行首 7px 小方块：与 PostCard/EntryCard 的列表行同一套指示语言 */
  .toc li { position: relative; padding: 0.34rem 0 0.34rem 1.1rem; }
  .toc li::before {
    content: ''; position: absolute; left: 0; top: 0.85rem;
    width: 7px; height: 7px; background: var(--border);
    transition: background-color 0.15s ease;
  }
  .toc li.on::before { background: var(--accent); }
  /* 文字色跟着小方块一起 0.15s 过渡：方块在渐入、文字硬切，同一个条目的两半各走各的会很突兀。
     字重过渡不了（非可变字体），但中日韩字形宽度不随字重变，加粗不会引起条目回流。 */
  .toc a { color: var(--text-muted); transition: color 0.15s ease; }
  .toc a:hover { color: var(--text); text-decoration: none; }
  .toc li.on a { color: var(--text); font-weight: 700; }
</style>
