---
import { NAV, SITE } from '../lib/site';
const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{SITE.author}<span class="en">{SITE.authorEn}</span></a>
    <nav aria-label="主导航">
      {NAV.map((item) => (
        <a
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <button id="theme-toggle" type="button" aria-label="切换明暗主题">◐</button>
  </div>
</header>
<script>
  /* 事件委托：View Transitions 换页后按钮会被替换，挂在 document 上的监听不会丢 */
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest?.('#theme-toggle');
    if (!btn) return;
    const html = document.documentElement;
    /* 切换瞬间给全元素挂 250ms 颜色过渡，避免明暗硬切 */
    html.classList.add('theme-anim');
    setTimeout(() => html.classList.remove('theme-anim'), 300);
    const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
<style>
  .site-header {
    border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .header-inner { display: flex; align-items: center; gap: 1.75rem; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 800; font-size: 1.05rem; color: var(--text); white-space: nowrap; }
  /* 品牌标记：墨色小方块内嵌强调蓝芯，页脚同款呼应 */
  .brand-mark { width: 14px; height: 14px; background: var(--ink); position: relative; flex: none; }
  .brand-mark::after { content: ''; position: absolute; inset: 4px; background: var(--accent); }
  .brand .en { font-weight: 500; color: var(--text-muted); margin-left: 0.2em; font-size: 0.8em; letter-spacing: 0.08em; }
  nav {
    display: flex; gap: 1.4rem; margin-left: auto;
    flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
  }
  nav::-webkit-scrollbar { display: none; }
  .nav-link { color: var(--text-muted); font-size: 0.95rem; white-space: nowrap; }
  .nav-link:hover { color: var(--text); text-decoration: none; }
  .nav-link.active { color: var(--text); font-weight: 700; box-shadow: inset 0 -2px var(--accent); padding-bottom: 2px; }
  #theme-toggle {
    background: none; border: 1.5px solid var(--border-strong); border-radius: 0; color: var(--text);
    cursor: pointer; padding: 0.25rem 0.6rem; transition: background-color 0.15s ease, color 0.15s ease;
  }
  #theme-toggle:hover { background: var(--ink); color: var(--bg); }
  /* 移动端：六项导航允许换行（隐形横向滚动条对触屏不可发现），高度放开自适应 */
  @media (max-width: 720px) {
    .header-inner { gap: 0.75rem; height: auto; min-height: 56px; flex-wrap: wrap; padding-block: 0.5rem; }
    .brand { font-size: 1rem; }
    nav { gap: 0.7rem; overflow-x: visible; flex-wrap: wrap; }
    .nav-link { font-size: 0.9rem; }
  }
</style>
