---
import { langOf, strings } from '../lib/i18n';
interface Props { switchHref: string; }
const { switchHref } = Astro.props;
const lang = langOf(Astro.url.pathname);
const t = strings(lang);
const isActive = (href: string) => Astro.url.pathname === href || Astro.url.pathname.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={lang === 'en' ? '/en/' : '/'}><span class="brand-mark" aria-hidden="true"></span>{lang === 'en' ? 'Samwaye Woo' : '胡圣炜'}{lang === 'zh' && <span class="en">HU SHENGWEI</span>}</a>
    <nav aria-label={t.navAria}>
      {t.navItems.map((item) => (
        <a
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>
    {/* 页头工具条：搜索 / 语言 / 主题装进同一个盒子，内部 1px 分隔线切格。
        三件套原先各画各的框：搜索是 1px 淡边加填充底、36px 高，EN 与主题是 1.5px 强边、44px 高，
        两套控件语言并排 28px，右上角读起来像三块贴歪的补丁。合成一条后只剩一套边框、一种高度；
        整条 44px，触控目标不缩水（搜索格与两个按钮格都是整格可点）。 */}
    <div class="header-tools">
      {/* 轻量搜索：GET 表单直达 /search/?q=，结果由搜索页客户端渲染；窄屏收起（页脚仍保留入口） */}
      <form class="header-search" action={t.searchAction} method="get" role="search">
        <input type="search" name="q" placeholder={t.searchPlaceholder} aria-label={t.searchAria} autocomplete="off" />
      </form>
      <a class="lang-switch" href={switchHref} aria-label={t.langSwitch.aria}>{t.langSwitch.label}</a>
      <button id="theme-toggle" type="button" aria-label={t.themeToggle.base} aria-pressed="false" data-label-dark={t.themeToggle.dark} data-label-light={t.themeToggle.light}>◐</button>
    </div>
  </div>
</header>
<script>
  /* 主题按钮状态同步：aria-pressed 表示「当前是否深色」，aria-label 顺带报出当前主题。
     服务端渲染时 aria-pressed 是静态的，深色用户首屏会读到错状态，故在模块求值时先同步一次；
     View Transitions 换页后按钮被替换，再挂 astro:page-load 同步。
     文案随语言走：BaseHead 在按钮上注入 data-label-dark/light（双语字典），脚本只读不写死。 */
  const syncThemeButton = () => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const dark = document.documentElement.dataset.theme === 'dark';
    btn.setAttribute('aria-pressed', String(dark));
    const label = dark ? btn.dataset.labelDark : btn.dataset.labelLight;
    if (label) btn.setAttribute('aria-label', label);
  };
  syncThemeButton();
  document.addEventListener('astro:page-load', syncThemeButton);

  /* 事件委托：View Transitions 换页后按钮会被替换，挂在 document 上的监听不会丢 */
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest?.('#theme-toggle');
    if (!btn) return;
    const html = document.documentElement;
    /* 切换瞬间给全元素挂 250ms 颜色过渡，避免明暗硬切 */
    html.classList.add('theme-anim');
    setTimeout(() => html.classList.remove('theme-anim'), 300);
    const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('theme', next);
    syncThemeButton();
  });

  /* 语言切换器点击即落 cookie：之后首访协商不再弹跳，尊重用户显式选择 */
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest?.('a.lang-switch');
    if (!link) return;
    const to = link.getAttribute('data-lang') === 'en' ? 'en' : 'zh';
    document.cookie = `site-lang=${to};max-age=31536000;path=/;samesite=lax`;
  });
</script>
<style>
  .site-header {
    border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .header-inner { display: flex; align-items: center; gap: 1.75rem; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 800; font-size: 1.05rem; color: var(--text); white-space: nowrap; }
  /* 品牌标记：墨色小方块内嵌强调蓝芯，页脚同款呼应 */
  .brand-mark { width: 14px; height: 14px; background: var(--ink); position: relative; flex: none; }
  .brand-mark::after { content: ''; position: absolute; inset: 4px; background: var(--accent); }
  .brand .en { font-weight: 500; color: var(--text-muted); margin-left: 0.2em; font-size: 0.8em; letter-spacing: 0.08em; }
  nav {
    display: flex; gap: 1.4rem; margin-left: auto;
    flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
  }
  nav::-webkit-scrollbar { display: none; }
  /* 触控目标 ≥44px：撑高可点区域，字号与版式不动；选中下划线落在 44px 盒底 */
  .nav-link { color: var(--text-muted); font-size: 0.95rem; white-space: nowrap; display: inline-flex; align-items: center; min-height: 44px; }
  .nav-link:hover { color: var(--text); text-decoration: none; }
  .nav-link.active { color: var(--text); font-weight: 700; box-shadow: inset 0 -2px var(--accent); }
  /* 页头工具条：一个盒子装三件事，内部 1px 分隔线切格，整条 44px 高。
     边框走 --border（装饰性分隔），填充 --surface 让它在页头浮起一格；
     这组元素不再各自描边，视觉上从「三块补丁」变成一件仪器。 */
  .header-tools {
    display: flex; align-items: stretch; height: 44px;
    border: 1px solid var(--border); background: var(--surface);
    transition: border-color 0.15s ease;
  }
  .header-tools:hover { border-color: var(--border-strong); }
  .header-search { display: flex; }
  .header-search input {
    font: inherit; font-size: 0.9rem; color: var(--text);
    background: none; border: 0; border-right: 1px solid var(--border);
    padding: 0 0.75rem; width: 9.5rem;
  }
  .header-search input::placeholder { color: var(--text-muted); }
  /* 焦点环画在格内：默认 outline 外扩会盖住相邻格的边线 */
  .header-search input:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  /* 语言切换：等宽字小格，与搜索格同高同边 */
  .lang-switch {
    font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);
    display: inline-flex; align-items: center; padding: 0 0.7rem;
    border-right: 1px solid var(--border); white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  /* hover 用淡墨底纹而非反白：反白块在暗色下会闪出一块奶油底（「暗色不做反白色块」同一条教训）。
     下划线要显式关掉：它是格内按钮，全局 a:hover 的下划线会把它拉回链接外观 */
  .lang-switch:hover, #theme-toggle:hover { background: color-mix(in srgb, var(--ink) 12%, transparent); color: var(--text); text-decoration: none; }
  #theme-toggle {
    background: none; border: 0; border-radius: 0; padding: 0; color: var(--text);
    cursor: pointer; width: 44px; display: inline-flex; align-items: center; justify-content: center;
    /* 字形来自系统 symbol 字体（Space Mono 无此码位）：字号必须自己钉住，
       否则按钮不继承字体，落到 UA 默认的 Arial 13.33px */
    font: inherit; font-size: 1rem; line-height: 1;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  /* 移动端：六项导航允许换行（隐形横向滚动条对触屏不可发现），高度放开自适应；迷你搜索框收起 */
  @media (max-width: 960px) {
    .header-search { display: none; }
  }
  @media (max-width: 720px) {
    .header-inner { gap: 0.75rem; height: auto; min-height: 56px; flex-wrap: wrap; padding-block: 0.5rem; }
    .brand { font-size: 1rem; }
    nav { gap: 0.7rem; overflow-x: visible; flex-wrap: wrap; }
    .nav-link { font-size: 0.9rem; }
    /* 换行后工具条独占一行：靠右收齐，别让它孤零零挂在左边 */
    .header-tools { margin-left: auto; }
  }
</style>
