---
import { NAV, SITE } from '../lib/site';
const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{SITE.author}<span class="en">{SITE.authorEn}</span></a>
    <nav aria-label="主导航">
      {NAV.map((item) => (
        <a
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>
    {/* 轻量搜索：GET 表单直达 /search/?q=，结果由搜索页客户端渲染；窄屏收起（页脚仍保留入口） */}
    <form class="header-search" action="/search/" method="get" role="search">
      <input type="search" name="q" placeholder="搜索" aria-label="站内搜索" autocomplete="off" />
    </form>
    <button id="theme-toggle" type="button" aria-label="切换明暗主题" aria-pressed="false">◐</button>
  </div>
</header>
<script>
  /* 主题按钮状态同步：aria-pressed 表示「当前是否深色」，aria-label 顺带报出当前主题。
     服务端渲染时 aria-pressed 是静态的，深色用户首屏会读到错状态，故在模块求值时先同步一次；
     View Transitions 换页后按钮被替换，再挂 astro:page-load 同步。 */
  const syncThemeButton = () => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const dark = document.documentElement.dataset.theme === 'dark';
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute('aria-label', `切换明暗主题（当前：${dark ? '深色' : '浅色'}）`);
  };
  syncThemeButton();
  document.addEventListener('astro:page-load', syncThemeButton);

  /* 事件委托：View Transitions 换页后按钮会被替换，挂在 document 上的监听不会丢 */
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest?.('#theme-toggle');
    if (!btn) return;
    const html = document.documentElement;
    /* 切换瞬间给全元素挂 250ms 颜色过渡，避免明暗硬切 */
    html.classList.add('theme-anim');
    setTimeout(() => html.classList.remove('theme-anim'), 300);
    const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('theme', next);
    syncThemeButton();
  });
</script>
<style>
  .site-header {
    border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .header-inner { display: flex; align-items: center; gap: 1.75rem; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 800; font-size: 1.05rem; color: var(--text); white-space: nowrap; }
  /* 品牌标记：墨色小方块内嵌强调蓝芯，页脚同款呼应 */
  .brand-mark { width: 14px; height: 14px; background: var(--ink); position: relative; flex: none; }
  .brand-mark::after { content: ''; position: absolute; inset: 4px; background: var(--accent); }
  .brand .en { font-weight: 500; color: var(--text-muted); margin-left: 0.2em; font-size: 0.8em; letter-spacing: 0.08em; }
  nav {
    display: flex; gap: 1.4rem; margin-left: auto;
    flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
  }
  nav::-webkit-scrollbar { display: none; }
  /* 触控目标 ≥44px：撑高可点区域，字号与版式不动；选中下划线落在 44px 盒底 */
  .nav-link { color: var(--text-muted); font-size: 0.95rem; white-space: nowrap; display: inline-flex; align-items: center; min-height: 44px; }
  .nav-link:hover { color: var(--text); text-decoration: none; }
  .nav-link.active { color: var(--text); font-weight: 700; box-shadow: inset 0 -2px var(--accent); }
  /* 迷你搜索框：直角细描边，聚焦转强调蓝；跟随导航右侧排布（nav 的 auto 外边距负责收拢） */
  .header-search input {
    font: inherit; font-size: 0.88rem; color: var(--text);
    background: var(--surface); border: 1px solid var(--border); border-radius: 0;
    padding: 0.3rem 0.7rem; width: 9.5rem;
    transition: border-color 0.15s ease;
  }
  .header-search input::placeholder { color: var(--text-muted); }
  .header-search input:hover { border-color: var(--border-strong); }
  .header-search input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-color: var(--accent); }
  #theme-toggle {
    background: none; border: 1.5px solid var(--border-strong); border-radius: 0; color: var(--text);
    cursor: pointer; padding: 0.25rem 0.6rem; transition: background-color 0.15s ease, color 0.15s ease;
    /* 触控目标 ≥44px：方形可点区域，图标居中 */
    min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center;
  }
  #theme-toggle:hover { background: var(--ink); color: var(--bg); }
  /* 移动端：六项导航允许换行（隐形横向滚动条对触屏不可发现），高度放开自适应；迷你搜索框收起 */
  @media (max-width: 960px) {
    .header-search { display: none; }
  }
  @media (max-width: 720px) {
    .header-inner { gap: 0.75rem; height: auto; min-height: 56px; flex-wrap: wrap; padding-block: 0.5rem; }
    .brand { font-size: 1rem; }
    nav { gap: 0.7rem; overflow-x: visible; flex-wrap: wrap; }
    .nav-link { font-size: 0.9rem; }
  }
</style>
