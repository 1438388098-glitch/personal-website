---
import { SITE, SITE_PATHS, THEME_COLORS } from '../lib/site';
import { ClientRouter } from 'astro:transitions';
import fontsCssUrl from '../styles/fonts.css?url';
/* 首屏 preload：下面 8 个 woff2 是展示字族（--font-display，Noto Sans SC）在站内展示字重
   文本上命中的分片（可变字体 wght 轴单文件覆盖全部字重，分片编号与旧静态 900 档一致）。分两组：
   - 品牌名分片（57/112/113）：页头 .brand「胡圣炜」每页可见，故全站每页 preload；
     「胡」=112、「圣」=113、「炜」=57。
   - hero 分片（114/116/117/118/119）：被首页主标题「法学在读，业余造工具。」额外命中，
     仅首页 preload，其余页面注入纯属浪费高优先级带宽。
   其余上百个分片不 preload，仍按需加载；正文 400/700 不 preload（非首屏关键路径）。
   维护提示：换首页 hero 站名或主标题文案时，必须同步重新计算并更新这组分片（步骤：读
   node_modules/@fontsource-variable/noto-sans-sc/wght.css 的 unicode-range，对新文案逐字求命中分片），
   否则新字符会退化为「等字体 CSS 生效后再按需下载」，preload 收益失效。 */
import fontNotoSans57 from '@fontsource-variable/noto-sans-sc/files/noto-sans-sc-57-wght-normal.woff2?url';
import fontNotoSans112 from '@fontsource-variable/noto-sans-sc/files/noto-sans-sc-112-wght-normal.woff2?url';
import fontNotoSans113 from '@fontsource-variable/noto-sans-sc/files/noto-sans-sc-113-wght-normal.woff2?url';
import fontNotoSans114 from '@fontsource-variable/noto-sans-sc/files/noto-sans-sc-114-wght-normal.woff2?url';
import fontNotoSans116 from '@fontsource-variable/noto-sans-sc/files/noto-sans-sc-116-wght-normal.woff2?url';
import fontNotoSans117 from '@fontsource-variable/noto-sans-sc/files/noto-sans-sc-117-wght-normal.woff2?url';
import fontNotoSans118 from '@fontsource-variable/noto-sans-sc/files/noto-sans-sc-118-wght-normal.woff2?url';
import fontNotoSans119 from '@fontsource-variable/noto-sans-sc/files/noto-sans-sc-119-wght-normal.woff2?url';
/* 品牌名分片：页头 .brand「胡圣炜」每页可见，全站每页 preload */
const fontNotoBrandShards = [fontNotoSans57, fontNotoSans112, fontNotoSans113];
/* hero 文案独有分片：仅首页 preload */
const fontNotoHeroShards = [fontNotoSans114, fontNotoSans116, fontNotoSans117, fontNotoSans118, fontNotoSans119];
interface Props { title: string; description?: string; type?: 'website' | 'article'; image?: string; noindex?: boolean; publishedTime?: Date; }
const { title, description = SITE.description, type = 'website', image = SITE_PATHS.ogImage, noindex = false, publishedTime } = Astro.props;
const pageTitle = title.includes(SITE.author) ? title : `${title} · ${SITE.title}`;
/* 域名单一事实源：astro.config.mjs 的 site 字段（经 Astro.site 注入） */
const siteUrl = Astro.site ?? new URL(SITE.url);
const ogImage = new URL(image, siteUrl);
/* 尺寸只对已知的默认 og 图输出：自定义 image 尺寸未知，硬写 1200x630 会误导抓取器 */
const isDefaultOgImage = image === SITE_PATHS.ogImage;
---
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL(SITE_PATHS.feed, siteUrl)} />
<link rel="sitemap" href={SITE_PATHS.sitemap} />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl)} />}
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={new URL(Astro.url.pathname, siteUrl)} />
<meta property="og:image" content={ogImage} />
{isDefaultOgImage && <meta property="og:image:width" content="1200" />}
{isDefaultOgImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:site_name" content={SITE.title} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{/* 手机浏览器地址栏随明暗主题着色（与 global.css 的 --bg 同源）；模板内不能用裸 CSS 注释，会被当文本输出截断 head */}
<meta name="theme-color" content={THEME_COLORS.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={THEME_COLORS.dark} media="(prefers-color-scheme: dark)" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{/* 首屏字体分片 preload：preload 的是 woff2 文件本身（不是 CSS），高优先级与 HTML 解析并行取回，
    字体 CSS 异步生效后立即可用，省去「CSS 生效后才按需发现分片」的串行等待。
    crossorigin 必须带：字体一律以 CORS 模式请求，缺了会二次下载。分片选择依据见 frontmatter 注释。
    品牌名分片（57/112/113）全站每页注入：页头 .brand「胡圣炜」每页可见；
    hero 分片仅首页注入：其余页面几乎无人命中，却抢走高优先级带宽 */}
{fontNotoBrandShards.map((href) => (
  <link rel="preload" as="font" type="font/woff2" crossorigin href={href} />
))}
{Astro.url.pathname === '/' && fontNotoHeroShards.map((href) => (
  <link rel="preload" as="font" type="font/woff2" crossorigin href={href} />
))}
{/* 字体声明非阻塞加载：print 样式不拦首绘，加载完翻转为 all；无 JS 环境由 noscript 兜底 */}
<link rel="stylesheet" href={fontsCssUrl} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={fontsCssUrl} /></noscript>
<ClientRouter />
<script is:inline>
  (function () {
    function applyTheme() {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.dataset.theme = 'dark';
      } else {
        document.documentElement.dataset.theme = 'light';
      }
    }
    applyTheme();
    /* View Transitions 换页会替换 <html>，换页后必须重放主题，否则闪白 */
    document.addEventListener('astro:after-swap', applyTheme);
  })();
</script>
