---
import { SITE } from '../lib/site';
import { ClientRouter } from 'astro:transitions';
import fontsCssUrl from '../styles/fonts.css?url';
/* 首屏 preload：下面 8 个 woff2 是首页 hero 展示文案命中且仅命中的分片（Noto Sans SC 900）。
   选片依据：展示字族（--font-display）的 900 字重只作用于品牌名与 h1 展示标题；
   首屏 900 文本 = 站名「胡圣炜」+ 主标题「法学在读，业余造工具。」共 14 个去重字符，
   逐一比对其码点与 900.css 各 @font-face 的 unicode-range，落在 57/112-119 这 8 个分片。
   其余上百个分片不 preload，仍按需加载；正文 400/700 不 preload（非首屏关键路径）。
   维护提示：换首页 hero 站名或主标题文案时，必须同步重新计算并更新这组分片（步骤：读
   node_modules/@fontsource/noto-sans-sc/900.css 的 unicode-range，对新文案逐字求命中分片），
   否则新字符会退化为「等字体 CSS 生效后再按需下载」，preload 收益失效。 */
import fontNotoSans57 from '@fontsource/noto-sans-sc/files/noto-sans-sc-57-900-normal.woff2?url';
import fontNotoSans112 from '@fontsource/noto-sans-sc/files/noto-sans-sc-112-900-normal.woff2?url';
import fontNotoSans113 from '@fontsource/noto-sans-sc/files/noto-sans-sc-113-900-normal.woff2?url';
import fontNotoSans114 from '@fontsource/noto-sans-sc/files/noto-sans-sc-114-900-normal.woff2?url';
import fontNotoSans116 from '@fontsource/noto-sans-sc/files/noto-sans-sc-116-900-normal.woff2?url';
import fontNotoSans117 from '@fontsource/noto-sans-sc/files/noto-sans-sc-117-900-normal.woff2?url';
import fontNotoSans118 from '@fontsource/noto-sans-sc/files/noto-sans-sc-118-900-normal.woff2?url';
import fontNotoSans119 from '@fontsource/noto-sans-sc/files/noto-sans-sc-119-900-normal.woff2?url';
/* hero 文案覆盖的分片清单（与上方 import 一一对应，供下方 preload 循环使用） */
const fontNotoHeroShards = [fontNotoSans57, fontNotoSans112, fontNotoSans113, fontNotoSans114, fontNotoSans116, fontNotoSans117, fontNotoSans118, fontNotoSans119];
interface Props { title: string; description?: string; type?: 'website' | 'article'; image?: string; noindex?: boolean; }
const { title, description = SITE.description, type = 'website', image = '/og-default.png', noindex = false } = Astro.props;
const pageTitle = title.includes(SITE.author) ? title : `${title} · ${SITE.title}`;
/* 域名单一事实源：astro.config.mjs 的 site 字段（经 Astro.site 注入） */
const siteUrl = Astro.site ?? new URL(SITE.url);
const ogImage = new URL(image, siteUrl);
---
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('/feed.xml', siteUrl)} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl)} />}
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={new URL(Astro.url.pathname, siteUrl)} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={SITE.title} />
{/* 手机浏览器地址栏随明暗主题着色（与 global.css 的 --bg 同源）；模板内不能用裸 CSS 注释，会被当文本输出截断 head */}
<meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#151513" media="(prefers-color-scheme: dark)" />
<meta name="twitter:card" content="summary_large_image" />
{/* 首屏字体分片 preload：preload 的是 woff2 文件本身（不是 CSS），高优先级与 HTML 解析并行取回，
    字体 CSS 异步生效后立即可用，省去「CSS 生效后才按需发现分片」的串行等待。
    crossorigin 必须带：字体一律以 CORS 模式请求，缺了会二次下载。分片选择依据见 frontmatter 注释 */}
{fontNotoHeroShards.map((href) => (
  <link rel="preload" as="font" type="font/woff2" crossorigin href={href} />
))}
{/* 字体声明非阻塞加载：print 样式不拦首绘，加载完翻转为 all；无 JS 环境由 noscript 兜底 */}
<link rel="stylesheet" href={fontsCssUrl} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={fontsCssUrl} /></noscript>
<ClientRouter />
<script is:inline>
  (function () {
    function applyTheme() {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.dataset.theme = 'dark';
      } else {
        document.documentElement.dataset.theme = 'light';
      }
    }
    applyTheme();
    /* View Transitions 换页会替换 <html>，换页后必须重放主题，否则闪白 */
    document.addEventListener('astro:after-swap', applyTheme);
  })();
</script>
