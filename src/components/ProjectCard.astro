---
import { formatDate } from '../lib/format';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; showMetrics?: boolean; index?: number; }
const { project, showMetrics = true, index } = Astro.props;
const { title, summary, metrics, date, group } = project.data;
---
<article class="card project-card">
  {index !== undefined && <span class="idx mono" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
  <p class="meta">{group} · {formatDate(date)}</p>
  <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
  <p class="summary">{summary}</p>
  {showMetrics && metrics.length > 0 && (
    <ul class="metrics">
      {metrics.slice(0, 2).map((m) => (
        <li><strong class="mono">{m.value}</strong> {m.label}</li>
      ))}
    </ul>
  )}
</article>
<style>
  .project-card { padding: 1.4rem 1.6rem; }
  /* 编号框：等宽数字描边小方框，卡片 hover 时反色为强调蓝 */
  .idx {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 2rem; height: 1.5rem; padding: 0 0.4rem;
    font-size: 0.82rem; font-weight: 700;
    border: 1.5px solid var(--border-strong); margin-bottom: 0.8rem;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  /* 反色用 --bg 而非白：暗色下强调蓝变浅蓝，白字对比不足，深底色字才够 */
  .project-card:hover .idx { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .meta { color: var(--text-muted); font-size: 0.85rem; margin: 0 0 0.4rem; }
  h3 { margin: 0 0 0.5rem; font-size: 1.22rem; }
  h3 a { color: var(--text); }
  h3 a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; text-decoration-color: var(--accent); }
  .summary { color: var(--text-muted); margin: 0 0 0.75rem; }
  .metrics { list-style: none; display: flex; gap: 1.5rem; margin: 0; padding: 0.75rem 0 0; border-top: 1px solid var(--border); }
  .metrics li { font-size: 0.88rem; color: var(--text-muted); }
  .metrics strong { color: var(--text); font-weight: 700; font-size: 0.95rem; }
</style>
