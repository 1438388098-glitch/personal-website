---
import { langOf, strings, groupLabel, href } from '../lib/i18n';
import { formatDate } from '../lib/format';
import type { AnyProject } from '../lib/projects';
interface Props { project: AnyProject; showMetrics?: boolean; index?: number; }
const { project, showMetrics = true, index } = Astro.props;
const lang = langOf(Astro.url.pathname);
const t = strings(lang);
const { title, summary, metrics, date, group, links } = project.data;
/* 仓库直达：只认 links 里的 GitHub 地址，列表页一键到仓库，不必先进详情页 */
const repo = links.find((l) => l.url.includes('github.com'));
---
<article class="card project-card">
  {index !== undefined && <span class="idx mono" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
  <p class="meta">{groupLabel(lang, group)} · {formatDate(date, lang)}{repo && <> · <a class="repo" href={repo.url} target="_blank" rel="noopener noreferrer" aria-label={`${t.projects.repo}${t.footer.opensInNew}`}>{t.projects.repo}</a></>}</p>
  <h3><a href={href(lang, `/projects/${project.id}/`)}>{title}</a></h3>
  <p class="summary">{summary}</p>
  {showMetrics && metrics.length > 0 && (
    <ul class="metrics">
      {metrics.slice(0, 2).map((m) => (
        <li><span class="k">{m.label}</span><span class="v mono">{m.value}</span></li>
      ))}
    </ul>
  )}
</article>
<style>
  /* 卡片排成 flex 列：指标行才能用 margin-top:auto 贴住同排卡片的底边 */
  .project-card { padding: 1.4rem 1.6rem; display: flex; flex-direction: column; }
  /* 编号框：等宽数字描边小方框，卡片 hover 时反色为强调蓝。
     align-self 顶住左端：卡变 flex 列后行内元素默认会被拉满整行 */
  .idx {
    align-self: flex-start;
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 2rem; height: 1.5rem; padding: 0 0.4rem;
    font-size: 0.82rem; font-weight: 700;
    border: 1.5px solid var(--border-strong); margin-bottom: 0.8rem;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  /* 反色用 --bg 而非白：暗色下强调蓝变浅蓝，白字对比不足，深底色字才够 */
  .project-card:hover .idx { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .meta { color: var(--text-muted); font-size: 0.85rem; margin: 0 0 0.4rem; }
  /* 仓库外链：与 meta 同字号，hover 转强调蓝（与全站外链语言一致） */
  .repo { color: var(--text-muted); white-space: nowrap; }
  .repo:hover { color: var(--accent); }
  h3 { margin: 0 0 0.5rem; font-size: var(--fs-card-title); }
  h3 a { color: var(--text); }
  h3 a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; text-decoration-color: var(--accent); }
  .summary { color: var(--text-muted); margin: 0 0 0.75rem; }
  /* 指标成对：标签在上、值在下。原先写「值 + 空格 + 标签」，会读成「12 包 / 323 题评测规模」
     「规则 27.40基线锚点」；两条指标之间隔 1.5rem，反而比值与它的标签更宽，层级是反的。 */
  .metrics {
    list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem 2.2rem;
    margin: auto 0 0; padding: 0.8rem 0 0; border-top: 1px solid var(--border);
  }
  .metrics li { display: flex; flex-direction: column; gap: 0.05rem; }
  .metrics .k { font-size: 0.72rem; color: var(--text-muted); }
  .metrics .v { color: var(--text); font-weight: 700; font-size: 1rem; }
</style>
