---
import { HOME_METRICS, METRICS_AS_OF } from '../lib/metrics';
---
<section class="metric-strip" aria-label="关键指标">
  <div class="metrics">
    {HOME_METRICS.map((m) => (
      <div class="metric">
        <span class="value">{m.value}</span>
        <span class="label">{m.label}</span>
        <span class="detail">{m.detail}</span>
        <a class="source" href={`/projects/${m.source}/`}>来源：{m.source}</a>
      </div>
    ))}
  </div>
  <p class="as-of">数据截至 {METRICS_AS_OF}，逐项可溯源至对应项目案例页。</p>
</section>
<style>
  .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .metric { background: var(--bg); padding: 1.25rem 1.4rem; display: flex; flex-direction: column; gap: 0.2rem; transition: background-color 0.15s ease; }
  .metric:hover { background: var(--bg-soft); }
  .value { font-family: var(--font-serif); font-size: 2.4rem; font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums lining-nums; line-height: 1.15; letter-spacing: 0; }
  .label { font-weight: 600; }
  .detail { color: var(--text-muted); font-size: 0.85rem; }
  .source {
    color: var(--text-muted); font-size: 0.78rem; line-height: 1.7;
    align-self: flex-start; border: 1px solid var(--border); border-radius: 999px;
    padding: 0 0.6rem; margin-top: 0.35rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .source:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
  .as-of { color: var(--text-muted); font-size: 0.85rem; margin: 0.6rem 0 0; }
  @media (max-width: 720px) { .metrics { grid-template-columns: 1fr; } }
</style>
